{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://warpmetal.com/contracts/workspace-source-local-grant-v1.schema.json",
 "title":"SOURCE local grant, native admission, activation and control v1",
 "$defs":{
  "id":{"$ref":"https://warpmetal.com/contracts/workspace-workflow-v1.schema.json#/$defs/id"},
  "digest":{"$ref":"https://warpmetal.com/contracts/workspace-workflow-v1.schema.json#/$defs/digest"},
  "time":{"$ref":"https://warpmetal.com/contracts/workspace-workflow-v1.schema.json#/$defs/time"},
  "positive":{"$ref":"https://warpmetal.com/contracts/workspace-workflow-v1.schema.json#/$defs/positive"},
  "targetKind":{"enum":["cell_session","controller_activity"]},
  "envelopeSignature":{"$ref":"https://warpmetal.com/contracts/workspace-workflow-budget-v2.schema.json#/$defs/signature"},
  "currentControlRef":{
   "type":"object","additionalProperties":false,
   "required":["serviceRegistrationId","serviceGeneration","operationId","desiredRevision","actionRevision","controlRevision","configDigest","controlDigest","desiredState","observedAt","expiresAt"],
   "properties":{
    "serviceRegistrationId":{"$ref":"#/$defs/id"},"serviceGeneration":{"$ref":"#/$defs/positive"},
    "operationId":{"$ref":"#/$defs/id"},"desiredRevision":{"$ref":"#/$defs/positive"},"actionRevision":{"$ref":"#/$defs/positive"},"controlRevision":{"$ref":"#/$defs/positive"},
    "configDigest":{"$ref":"#/$defs/digest"},"controlDigest":{"$ref":"#/$defs/digest"},
    "desiredState":{"enum":["active","paused","stopped","retired","revoked"]},
    "observedAt":{"$ref":"#/$defs/time"},"expiresAt":{"$ref":"#/$defs/time"}
   }
  },
  "registeredProcessRef":{
   "type":"object","additionalProperties":false,
   "required":["sandboxId","sandboxGeneration","nativeInstance","nativeIdentityDigest","registrationDigest"],
   "properties":{"sandboxId":{"$ref":"#/$defs/id"},"sandboxGeneration":{"$ref":"#/$defs/positive"},"nativeInstance":{"$ref":"#/$defs/id"},"nativeIdentityDigest":{"$ref":"#/$defs/digest"},"registrationDigest":{"$ref":"#/$defs/digest"}}
  },
  "retainedExposureRef":{
   "type":"object","additionalProperties":false,
   "required":["fullManifestDigest","allocationId","reservationId","reservedUsdMicros"],
   "properties":{"fullManifestDigest":{"$ref":"#/$defs/digest"},"allocationId":{"$ref":"#/$defs/id"},"reservationId":{"$ref":"#/$defs/id"},"reservedUsdMicros":{"type":"integer","const":421000}}
  },
  "localGrant":{
   "type":"object","additionalProperties":false,
   "required":["formatVersion","purpose","evidenceClass","grantId","requestId","targetKind","preparationId","preparedTupleDigest","preparedReceiptDigest","credentialId","nativeCredentialId","authorityDigest","caseId","localCaseEnvelopeDigest","entry","candidateInventoryDigest","sourceTransportPermissionDigest","scope","qualification","sessionId","inputId","nativeGrant","registeredProcess","currentControl","retainedExposure","providerRequests","maxConcurrentPhysicalRequests","retries","issuedAt","deadlineAt","expiresAt"],
   "properties":{
    "formatVersion":{"type":"integer","const":1},"purpose":{"const":"source_local_execution_grant"},"evidenceClass":{"const":"source"},
    "grantId":{"$ref":"#/$defs/id"},"requestId":{"$ref":"#/$defs/id"},"targetKind":{"$ref":"#/$defs/targetKind"},
    "preparationId":{"$ref":"#/$defs/id"},"preparedTupleDigest":{"$ref":"#/$defs/digest"},"preparedReceiptDigest":{"$ref":"#/$defs/digest"},"credentialId":{"$ref":"#/$defs/id"},"nativeCredentialId":{"$ref":"#/$defs/id"},
    "authorityDigest":{"$ref":"#/$defs/digest"},"caseId":{"$ref":"#/$defs/id"},"localCaseEnvelopeDigest":{"$ref":"#/$defs/digest"},
    "entry":{"$ref":"https://warpmetal.com/contracts/workspace-source-local-transport-v1.schema.json#/$defs/localEntry"},
    "candidateInventoryDigest":{"$ref":"#/$defs/digest"},"sourceTransportPermissionDigest":{"$ref":"#/$defs/digest"},
    "scope":{"$ref":"https://warpmetal.com/contracts/workspace-workflow-producer-v1.schema.json#/$defs/controllerOwner"},
    "qualification":{"$ref":"https://warpmetal.com/contracts/workspace-source-local-transport-v1.schema.json#/$defs/qualification"},
    "sessionId":{"$ref":"https://api.warpmetal.com/contracts/cell-lifecycle-v3.schema.json#/$defs/nativeSessionId"},"inputId":{"$ref":"https://api.warpmetal.com/contracts/cell-lifecycle-v3.schema.json#/$defs/nativeInputId"},
    "nativeGrant":{"oneOf":[{"$ref":"https://api.warpmetal.com/contracts/cell-lifecycle-v3.schema.json#/$defs/executionGrant"},{"$ref":"https://warpmetal.com/contracts/workspace-workflow-producer-v1.schema.json#/$defs/controllerActivityGrant"}]},
    "registeredProcess":{"$ref":"#/$defs/registeredProcessRef"},"currentControl":{"$ref":"#/$defs/currentControlRef"},"retainedExposure":{"$ref":"#/$defs/retainedExposureRef"},
    "providerRequests":{"type":"integer","const":0},"maxConcurrentPhysicalRequests":{"type":"integer","const":1},"retries":{"type":"integer","const":0},
    "issuedAt":{"$ref":"#/$defs/time"},"deadlineAt":{"$ref":"#/$defs/time"},"expiresAt":{"$ref":"#/$defs/time"}
   },
   "allOf":[
    {"properties":{"currentControl":{"properties":{"desiredState":{"const":"active"}}}}},
    {"if":{"properties":{"targetKind":{"const":"cell_session"}}},"then":{"properties":{"nativeGrant":{"$ref":"https://api.warpmetal.com/contracts/cell-lifecycle-v3.schema.json#/$defs/executionGrant"},"entry":{"properties":{"targetKind":{"const":"cell_session"},"oracle":{"enum":["http_cancel","tool_cancel"]}}}}},"else":{"properties":{"nativeGrant":{"allOf":[{"$ref":"https://warpmetal.com/contracts/workspace-workflow-producer-v1.schema.json#/$defs/controllerActivityGrant"},{"properties":{"requestIndex":{"const":1},"physicalIndex":{"const":3},"maxInputTokens":{"const":1046576},"maxOutputTokens":{"const":1000},"maxUsdMicros":{"const":421000}}}]},"entry":{"properties":{"targetKind":{"const":"controller_activity"},"oracle":{"const":"controller_deadline"},"localPreparationOrdinal":{"const":3},"localDeliveryOrdinal":{"const":3}}}}}}
   ]
  },
  "localGrantEnvelope":{"type":"object","additionalProperties":false,"required":["payload","keyId","signature"],"properties":{"payload":{"$ref":"#/$defs/localGrant"},"keyId":{"$ref":"#/$defs/id"},"signature":{"$ref":"#/$defs/envelopeSignature"}}},
  "childAdmissionCarrier":{"$comment":"Backend/journal carrier ONLY. Deliver preparedReceipt through existing child binding and ONLY grant through existing guard.cellGrant; never send this new wrapper to native.","type":"object","additionalProperties":false,"required":["formatVersion","targetKind","preparedReceipt","grant"],"properties":{"formatVersion":{"type":"integer","const":3},"targetKind":{"const":"cell_session"},"preparedReceipt":{"$ref":"https://api.warpmetal.com/contracts/cell-lifecycle-v3.schema.json#/$defs/preparedReceipt"},"grant":{"$ref":"https://api.warpmetal.com/contracts/cell-lifecycle-v3.schema.json#/$defs/executionGrant"}}},
  "localAdmission":{"$comment":"Parent variant is byte-shape-identical existing native format1 admission; zero new native fields.","oneOf":[{"$ref":"https://warpmetal.com/contracts/workspace-workflow-producer-v1.schema.json#/$defs/controllerNativeAdmission"},{"$ref":"#/$defs/childAdmissionCarrier"}]},
  "originalParentHeader":{"type":"object","additionalProperties":false,"required":["formatVersion","targetKind","preparationId","preparedReceiptDigest","authorizationSha256"],"properties":{"formatVersion":{"type":"integer","const":1},"targetKind":{"const":"controller_authorization"},"preparationId":{"$ref":"#/$defs/id"},"preparedReceiptDigest":{"$ref":"#/$defs/digest"},"authorizationSha256":{"$ref":"#/$defs/digest"}}},
  "originalAuthorizationEnvelope":{"type":"object","additionalProperties":false,"required":["payload","keyId","signature"],"properties":{"payload":{"oneOf":[{"$ref":"#/$defs/originalParentHeader"},{"$ref":"https://warpmetal.com/contracts/workspace-child-product-v1.schema.json#/$defs/authorizationObservation"}]},"keyId":{"$ref":"#/$defs/id"},"signature":{"$ref":"#/$defs/envelopeSignature"}}},
  "localActivation":{
   "type":"object","additionalProperties":false,
   "required":["formatVersion","purpose","evidenceClass","targetKind","preparationId","grantId","grantEnvelopeDigest","admissionDigest","preparedReceiptDigest","sourceTransportPermissionDigest","originalAuthorizationObservationDigest","authorizationSha256","currentControl","issuedAt","deadlineAt","expiresAt"],
   "properties":{"formatVersion":{"type":"integer","const":1},"purpose":{"const":"source_local_execution_activation"},"evidenceClass":{"const":"source"},"targetKind":{"$ref":"#/$defs/targetKind"},"preparationId":{"$ref":"#/$defs/id"},"grantId":{"$ref":"#/$defs/id"},"grantEnvelopeDigest":{"$ref":"#/$defs/digest"},"admissionDigest":{"$ref":"#/$defs/digest"},"preparedReceiptDigest":{"$ref":"#/$defs/digest"},"sourceTransportPermissionDigest":{"$ref":"#/$defs/digest"},"originalAuthorizationObservationDigest":{"$ref":"#/$defs/digest"},"authorizationSha256":{"$ref":"#/$defs/digest"},"currentControl":{"$ref":"#/$defs/currentControlRef"},"issuedAt":{"$ref":"#/$defs/time"},"deadlineAt":{"$ref":"#/$defs/time"},"expiresAt":{"$ref":"#/$defs/time"}},
   "allOf":[{"properties":{"currentControl":{"properties":{"desiredState":{"const":"active"}}}}}]
  },
  "localActivationEnvelope":{"type":"object","additionalProperties":false,"required":["payload","keyId","signature"],"properties":{"payload":{"$ref":"#/$defs/localActivation"},"keyId":{"$ref":"#/$defs/id"},"signature":{"$ref":"#/$defs/envelopeSignature"}}},
  "localActivationRequest":{"type":"object","additionalProperties":false,"required":["activation","headerObservation"],"properties":{"activation":{"$ref":"#/$defs/localActivationEnvelope"},"headerObservation":{"$ref":"#/$defs/originalAuthorizationEnvelope"}}},
  "localPublishedControl":{
   "type":"object","additionalProperties":false,
   "required":["formatVersion","purpose","evidenceClass","targetKind","preparationId","selection","admission","activation","currentControl"],
   "properties":{"formatVersion":{"type":"integer","const":1},"purpose":{"const":"source_local_published_control"},"evidenceClass":{"const":"source"},"targetKind":{"$ref":"#/$defs/targetKind"},"preparationId":{"$ref":"#/$defs/id"},"selection":{"$ref":"#/$defs/localGrantEnvelope"},"admission":{"$ref":"#/$defs/localAdmission"},"activation":{"$ref":"#/$defs/localActivationEnvelope"},"currentControl":{"$ref":"#/$defs/currentControlRef"}}
  },
  "offlineOperationRef":{
   "type":"object","additionalProperties":false,
   "required":["operationId","windowId","windowDigest","admissionDigest","requestDigest","requestIndex","localPreparationOrdinal","localDeliveryOrdinal"],
   "properties":{"operationId":{"$ref":"#/$defs/id"},"windowId":{"$ref":"#/$defs/id"},"windowDigest":{"$ref":"#/$defs/digest"},"admissionDigest":{"$ref":"#/$defs/digest"},"requestDigest":{"$ref":"#/$defs/digest"},"requestIndex":{"type":"integer","const":1},"localPreparationOrdinal":{"type":"integer","minimum":1,"maximum":3},"localDeliveryOrdinal":{"type":"integer","minimum":1,"maximum":3}}
  },
  "terminalReference":{
   "type":"object","additionalProperties":false,
   "required":["formatVersion","purpose","evidenceClass","targetKind","preparationId","grantId","sessionId","inputId","sourceTransportPermissionDigest","activationEnvelopeDigest","currentControl","registeredProcess","physicalOperation","terminalRevision","terminalEvent","eventsDigest","terminalDigest","quiescenceDigest","socketDigest","toolDigest","observedAt"],
   "properties":{
    "formatVersion":{"type":"integer","const":1},"purpose":{"const":"source_local_terminal_reference"},"evidenceClass":{"const":"source"},"targetKind":{"$ref":"#/$defs/targetKind"},"preparationId":{"$ref":"#/$defs/id"},"grantId":{"$ref":"#/$defs/id"},"sessionId":{"$ref":"https://api.warpmetal.com/contracts/cell-lifecycle-v3.schema.json#/$defs/nativeSessionId"},"inputId":{"$ref":"https://api.warpmetal.com/contracts/cell-lifecycle-v3.schema.json#/$defs/nativeInputId"},"sourceTransportPermissionDigest":{"$ref":"#/$defs/digest"},"activationEnvelopeDigest":{"$ref":"#/$defs/digest"},"currentControl":{"$ref":"#/$defs/currentControlRef"},"registeredProcess":{"$ref":"#/$defs/registeredProcessRef"},"physicalOperation":{"$ref":"#/$defs/offlineOperationRef"},"terminalRevision":{"$ref":"#/$defs/positive"},
    "terminalEvent":{"$ref":"https://warpmetal.com/contracts/workspace-workflow-producer-v1.schema.json#/$defs/controllerOutputLineage/properties/eventRefs/$defs/eventRef"},
    "eventsDigest":{"$ref":"#/$defs/digest"},"terminalDigest":{"$ref":"#/$defs/digest"},"quiescenceDigest":{"$ref":"#/$defs/digest"},"socketDigest":{"$ref":"#/$defs/digest"},"toolDigest":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/digest"}]},"observedAt":{"$ref":"#/$defs/time"}
   }
  }
 }
}
