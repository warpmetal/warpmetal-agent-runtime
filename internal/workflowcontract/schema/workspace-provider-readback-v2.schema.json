{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.warpmetal.com/contracts/workspace-provider-readback-v2.schema.json",
  "title": "Authenticated backend original provider ledger prefix; not a Runtime observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "authorityDigest",
    "opening",
    "reservations",
    "settlements",
    "snapshot"
  ],
  "properties": {
    "formatVersion": {
      "const": 2
    },
    "authorityDigest": {
      "$ref": "https://api.warpmetal.com/contracts/workspace-provider-accounting-v2.schema.json#/$defs/digest"
    },
    "opening": {
      "$ref": "https://api.warpmetal.com/contracts/workspace-provider-accounting-v2.schema.json#/$defs/openingHandshake"
    },
    "reservations": {
      "type": "array",
      "maxItems": 19,
      "items": {
        "$ref": "https://api.warpmetal.com/contracts/workspace-provider-accounting-v2.schema.json#/$defs/reservation"
      }
    },
    "settlements": {
      "type": "array",
      "maxItems": 19,
      "items": {
        "$ref": "https://api.warpmetal.com/contracts/workspace-provider-accounting-v2.schema.json#/$defs/settlementEnvelope"
      }
    },
    "snapshot": {
      "$ref": "https://api.warpmetal.com/contracts/workspace-provider-accounting-v2.schema.json#/$defs/ledgerSnapshot"
    }
  }
}
