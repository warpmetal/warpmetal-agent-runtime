{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.warpmetal.com/contracts/agent-workspace-configuration-v2.schema.json",
  "title": "Agent workspace declarative configuration v2 \u2014 agent setup",
  "description": "Additive v2 of the manager-frozen authoring document. Every v1 field keeps its exact v1 meaning (shared definitions are referenced, not copied); v2 adds one closed agentSetup object that carries AGENTS.md instructions, model providers/role defaults, tool providers, pinned skills, runtime, repo, first task and an advisory capacity hint. No secrets: auth is a provider-connection reference only. No execution, placement, payment or readiness authority; dependency/activation checks still run after this structural schema. Strict UTF-8/duplicate-key validation and the 262144-byte whole-envelope limit precede this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "workspaceName",
    "purpose",
    "profiles",
    "roles",
    "lanes",
    "limits",
    "agentSetup"
  ],
  "properties": {
    "formatVersion": {
      "const": 2
    },
    "workspaceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "profiles": {
      "$ref": "agent-workspace-configuration-v1.schema.json#/properties/profiles"
    },
    "roles": {
      "$ref": "agent-workspace-configuration-v1.schema.json#/properties/roles"
    },
    "lanes": {
      "$ref": "agent-workspace-configuration-v1.schema.json#/properties/lanes"
    },
    "limits": {
      "$ref": "agent-workspace-configuration-v1.schema.json#/properties/limits"
    },
    "agentSetup": {
      "$ref": "#/$defs/agentSetup"
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "imageRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@:-]{0,159}$"
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "agentSetup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentInstructions",
        "models",
        "toolProviders",
        "skills",
        "runtime"
      ],
      "properties": {
        "agentInstructions": {
          "$comment": "AGENTS.md markdown, stored verbatim and bounded. Secret material is refused by the pre-schema scan, not by this pattern.",
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "models": {
          "$ref": "#/$defs/models"
        },
        "toolProviders": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/toolProvider"
          }
        },
        "skills": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/skill"
          }
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "repo": {
          "oneOf": [
            {
              "$ref": "#/$defs/repo"
            },
            {
              "type": "null"
            }
          ]
        },
        "firstTask": {
          "oneOf": [
            {
              "$ref": "#/$defs/firstTask"
            },
            {
              "type": "null"
            }
          ]
        },
        "capacityHint": {
          "oneOf": [
            {
              "$ref": "#/$defs/capacityHint"
            },
            {
              "type": "null"
            }
          ]
        },
        "devops": {
          "$comment": "Admin-only system-catalog DevOps block (plan 16). It can only constrain the agent: every credential is a symbolic provider-connection requirement, never a value. The shared semantic validator rejects this block in owner/account documents.",
          "oneOf": [
            {
              "$ref": "#/$defs/devops"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providers",
        "roleDefaults"
      ],
      "properties": {
        "providers": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/modelProvider"
          }
        },
        "roleDefaults": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/roleDefault"
          }
        }
      }
    },
    "modelProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "auth"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "kind": {
          "enum": [
            "deepseek",
            "openai",
            "anthropic",
            "openai-compatible",
            "custom"
          ]
        },
        "displayName": {
          "$comment": "Owner-only label for a custom provider connection. Approved templates may never carry it (template validation rejects custom providers and display names).",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseUrl": {
          "$comment": "Owner custom or openai-compatible endpoint. Known providers use the platform endpoint. https only, no userinfo/query/fragment; owner template validation additionally rejects custom providers and non-allowlisted hosts.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 9,
              "maxLength": 512,
              "pattern": "^https://[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[0-9]{1,5})?(/[A-Za-z0-9._~%/-]*)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "auth": {
          "$ref": "#/$defs/connectionRequirement"
        }
      }
    },
    "connectionRequirement": {
      "$comment": "A symbolic provider-connection reference only. The owner binds the real connection in the account UI; no credential value, connection row id or auth mode is stored in a template.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connectionRef"
      ],
      "properties": {
        "connectionRef": {
          "$ref": "#/$defs/safeId"
        }
      }
    },
    "modelParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temperature": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "topP": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "maxOutputTokens": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoningEffort": {
          "oneOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "roleDefault": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleId",
        "providerId",
        "defaultModel",
        "allowedModels",
        "params"
      ],
      "properties": {
        "roleId": {
          "$ref": "#/$defs/safeId"
        },
        "providerId": {
          "$ref": "#/$defs/safeId"
        },
        "defaultModel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "allowedModels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
          }
        },
        "params": {
          "$ref": "#/$defs/modelParams"
        }
      }
    },
    "toolProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "endpointRef",
        "scopes",
        "approval",
        "auth"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "kind": {
          "enum": [
            "mcp",
            "connector",
            "cli"
          ]
        },
        "endpointRef": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "scopes": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
          }
        },
        "approval": {
          "enum": [
            "auto",
            "ask",
            "deny"
          ]
        },
        "auth": {
          "oneOf": [
            {
              "$ref": "#/$defs/connectionRequirement"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "sourceRepo",
        "pinnedRef",
        "requiredTools",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "sourceRepo": {
          "$comment": "owner/repo only; no scheme, host or credentials.",
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "pinnedRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@-]{0,127}$"
        },
        "requiredTools": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeId"
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imageRef",
        "toolProfile",
        "packages",
        "env"
      ],
      "properties": {
        "imageRef": {
          "$ref": "#/$defs/imageRef"
        },
        "toolProfile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "packages": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+=<>~^/-]{0,127}$"
          }
        },
        "env": {
          "$comment": "Environment variable NAMES only. Values and connection ids are refused, so no secret can be carried here.",
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          }
        }
      }
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "branch",
        "path",
        "setupCommands",
        "testCommands"
      ],
      "properties": {
        "url": {
          "$comment": "HTTPS without userinfo/query/fragment, or an SSH git address. Credentials in the URL are refused.",
          "type": "string",
          "minLength": 9,
          "maxLength": 512,
          "oneOf": [
            {
              "pattern": "^https://[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[0-9]{1,5})?(/[A-Za-z0-9._~%/-]*)*$"
            },
            {
              "pattern": "^git@[a-z0-9]([a-z0-9.-]*[a-z0-9])?:[A-Za-z0-9._/-]{1,255}$"
            }
          ]
        },
        "branch": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^/[A-Za-z0-9._/-]{0,255}$"
        },
        "setupCommands": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "testCommands": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/command"
          }
        }
      }
    },
    "firstTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "allowedChanges",
        "acceptance"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "allowedChanges": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "capacityHint": {
      "$comment": "Advisory only. Real capacity still comes from the owner capacity review; no sizing, order or payment authority.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxActiveChildren",
        "cpuMillis",
        "memoryMiB",
        "workspaceDiskGiB"
      ],
      "properties": {
        "maxActiveChildren": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "cpuMillis": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "memoryMiB": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "workspaceDiskGiB": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "devops": {
      "$comment": "Admin-only system-catalog DevOps block. Every credential is a connection requirement; production authority still comes from the runtime approval flow.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environments",
        "targets",
        "guardrails",
        "observability",
        "changeManagement",
        "pipelines",
        "telemetry",
        "bugReporting",
        "runbooks",
        "firstTask",
        "lanes"
      ],
      "properties": {
        "environments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/devopsEnvironment"
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/devopsTarget"
          }
        },
        "guardrails": {
          "$ref": "#/$defs/devopsGuardrails"
        },
        "observability": {
          "$ref": "#/$defs/devopsObservability"
        },
        "changeManagement": {
          "$ref": "#/$defs/devopsChangeManagement"
        },
        "pipelines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/devopsPipeline"
          }
        },
        "telemetry": {
          "$ref": "#/$defs/devopsTelemetry"
        },
        "bugReporting": {
          "$ref": "#/$defs/devopsBugReporting"
        },
        "runbooks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/devopsRunbook"
          }
        },
        "firstTask": {
          "$ref": "#/$defs/devopsFirstTask"
        },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/devopsLane"
          }
        }
      }
    },
    "devopsEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tier",
        "targets",
        "allowedActions",
        "approvals",
        "dryRunFirst",
        "changeWindow",
        "readOnly"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "tier": {
          "enum": [
            "dev",
            "staging",
            "prod"
          ]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeId"
          }
        },
        "allowedActions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "enum": [
              "read",
              "plan",
              "apply",
              "deploy",
              "rollback",
              "scale",
              "provision",
              "migrate",
              "backup",
              "restore",
              "destroy"
            ]
          }
        },
        "approvals": {
          "$comment": "Only owner/two_person exist: a write action can never be approved with 'none'. Production writes must name their approval explicitly (semantic validation).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "apply": {
              "enum": [
                "owner",
                "two_person"
              ]
            },
            "deploy": {
              "enum": [
                "owner",
                "two_person"
              ]
            },
            "rollback": {
              "enum": [
                "owner",
                "two_person"
              ]
            },
            "scale": {
              "enum": [
                "owner",
                "two_person"
              ]
            },
            "provision": {
              "enum": [
                "owner",
                "two_person"
              ]
            },
            "migrate": {
              "enum": [
                "owner",
                "two_person"
              ]
            },
            "backup": {
              "enum": [
                "owner",
                "two_person"
              ]
            },
            "restore": {
              "enum": [
                "owner",
                "two_person"
              ]
            },
            "destroy": {
              "enum": [
                "owner",
                "two_person"
              ]
            }
          }
        },
        "dryRunFirst": {
          "type": "boolean"
        },
        "changeWindow": {
          "oneOf": [
            {
              "$ref": "#/$defs/devopsChangeWindow"
            },
            {
              "type": "null"
            }
          ]
        },
        "readOnly": {
          "type": "boolean"
        }
      }
    },
    "devopsApproval": {
      "enum": [
        "owner",
        "two_person"
      ]
    },
    "devopsChangeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tz",
        "days",
        "start",
        "end"
      ],
      "properties": {
        "tz": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(?:/[A-Za-z0-9_+-]+)*$"
        },
        "days": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        },
        "start": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      }
    },
    "devopsTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "provider",
        "auth",
        "contextRef",
        "scopes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "kind": {
          "enum": [
            "host",
            "kubernetes",
            "managed_database",
            "object_storage",
            "network",
            "inventory"
          ]
        },
        "provider": {
          "enum": [
            "hivelocity",
            "latitude"
          ]
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "requiredConnectionKind",
            "connectionRef"
          ],
          "properties": {
            "kind": {
              "const": "provider_connection"
            },
            "requiredConnectionKind": {
              "enum": [
                "hivelocity_api_key",
                "latitude_api_key",
                "ssh_key"
              ]
            },
            "connectionRef": {
              "$ref": "#/$defs/safeId"
            }
          }
        },
        "contextRef": {
          "$ref": "#/$defs/safeId"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "enum": [
              "activity:read",
              "backups:read",
              "backups:write",
              "bgp:read",
              "databases:read",
              "databases:write",
              "devices:power",
              "devices:read",
              "devices:reload",
              "firewall:read",
              "firewall:write",
              "inventory:read",
              "ips:read",
              "lks:read",
              "lks:write",
              "networks:read",
              "networks:write",
              "products:read",
              "projects:read",
              "provisioning:write",
              "servers:power",
              "servers:read",
              "servers:write",
              "ssh_keys:read",
              "ssh_keys:write",
              "storage:read",
              "storage:write",
              "subnets:read"
            ]
          }
        }
      }
    },
    "devopsGuardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readOnlyByDefault",
        "prodWritesRequireApproval",
        "destructiveActions",
        "forbiddenPatterns",
        "dryRunFirst",
        "killSwitch",
        "egressAllowlist",
        "noInbound",
        "auditLevel",
        "publicExposureApproval",
        "backupsRequired"
      ],
      "properties": {
        "readOnlyByDefault": {
          "type": "boolean"
        },
        "prodWritesRequireApproval": {
          "type": "boolean"
        },
        "destructiveActions": {
          "const": "two_person"
        },
        "forbiddenPatterns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
          }
        },
        "dryRunFirst": {
          "type": "boolean"
        },
        "killSwitch": {
          "enum": [
            "owner",
            "two_person"
          ]
        },
        "egressAllowlist": {
          "$comment": "Bare host or *.domain entries only: no scheme, URL userinfo, IP literal, loopback or cloud-metadata host.",
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 253,
            "pattern": "^(\\*\\.)?[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
          }
        },
        "noInbound": {
          "type": "boolean"
        },
        "auditLevel": {
          "const": "command_and_result"
        },
        "publicExposureApproval": {
          "enum": [
            "owner",
            "two_person"
          ]
        },
        "backupsRequired": {
          "type": "boolean"
        }
      }
    },
    "devopsObservability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "auth"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/safeId"
              },
              "kind": {
                "enum": [
                  "logs",
                  "metrics",
                  "traces",
                  "logs_metrics"
                ]
              },
              "auth": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "requiredConnectionKind",
                  "connectionRef"
                ],
                "properties": {
                  "kind": {
                    "const": "provider_connection"
                  },
                  "requiredConnectionKind": {
                    "enum": [
                      "hivelocity_api_key",
                      "latitude_api_key",
                      "ssh_key",
                      "github_app",
                      "github_token",
                      "telemetry_sink",
                      "alerting"
                    ]
                  },
                  "connectionRef": {
                    "$ref": "#/$defs/safeId"
                  }
                }
              }
            }
          }
        }
      }
    },
    "devopsChangeManagement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tickets",
        "requireRollbackPlan"
      ],
      "properties": {
        "tickets": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "required"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "github_issues",
                    "linear",
                    "jira"
                  ]
                },
                "required": {
                  "type": "boolean"
                }
              }
            }
          ]
        },
        "requireRollbackPlan": {
          "type": "boolean"
        }
      }
    },
    "devopsPipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "repository",
        "workflowPath",
        "environment",
        "runnerHostTarget",
        "runnerLabels",
        "auth",
        "approval",
        "rollbackPlanRequired"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "enum": [
            "build_test",
            "deploy",
            "migrate",
            "backup"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "workflowPath": {
          "type": "string",
          "minLength": 20,
          "maxLength": 200,
          "pattern": "^\\.github/workflows/[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.ya?ml$"
        },
        "environment": {
          "$ref": "#/$defs/safeId"
        },
        "runnerHostTarget": {
          "$ref": "#/$defs/safeId"
        },
        "runnerLabels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "requiredConnectionKind",
            "connectionRef"
          ],
          "properties": {
            "kind": {
              "const": "provider_connection"
            },
            "requiredConnectionKind": {
              "enum": [
                "github_app",
                "github_token"
              ]
            },
            "connectionRef": {
              "$ref": "#/$defs/safeId"
            }
          }
        },
        "approval": {
          "enum": [
            "owner",
            "two_person"
          ]
        },
        "rollbackPlanRequired": {
          "type": "boolean"
        }
      }
    },
    "devopsTelemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collectors",
        "sinks",
        "alerting"
      ],
      "properties": {
        "collectors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "targets",
              "redaction",
              "retentionDays"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/safeId"
              },
              "kind": {
                "enum": [
                  "otel_collector",
                  "vector",
                  "node_exporter",
                  "promtail"
                ]
              },
              "targets": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/safeId"
                }
              },
              "redaction": {
                "enum": [
                  "secrets",
                  "secrets_and_pii"
                ]
              },
              "retentionDays": {
                "type": "integer",
                "minimum": 1,
                "maximum": 365
              }
            }
          }
        },
        "sinks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "auth"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/safeId"
              },
              "kind": {
                "enum": [
                  "loki",
                  "prometheus",
                  "grafana",
                  "datadog",
                  "grafana_cloud"
                ]
              },
              "auth": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "requiredConnectionKind",
                  "connectionRef"
                ],
                "properties": {
                  "kind": {
                    "const": "provider_connection"
                  },
                  "requiredConnectionKind": {
                    "enum": [
                      "telemetry_sink"
                    ]
                  },
                  "connectionRef": {
                    "$ref": "#/$defs/safeId"
                  }
                }
              }
            }
          }
        },
        "alerting": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "auth"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/safeId"
                },
                "kind": {
                  "enum": [
                    "slack",
                    "pagerduty",
                    "github_issues"
                  ]
                },
                "auth": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "requiredConnectionKind",
                    "connectionRef"
                  ],
                  "properties": {
                    "kind": {
                      "const": "provider_connection"
                    },
                    "requiredConnectionKind": {
                      "enum": [
                        "alerting"
                      ]
                    },
                    "connectionRef": {
                      "$ref": "#/$defs/safeId"
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "devopsBugReporting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destinationKind",
        "requiresBilateralGrant",
        "runbookId",
        "artifactScopes",
        "maxArtifactBytes",
        "expiryHours",
        "requiresDigestVerification",
        "audited"
      ],
      "properties": {
        "destinationKind": {
          "const": "foreman_peer"
        },
        "requiresBilateralGrant": {
          "const": true
        },
        "runbookId": {
          "$ref": "#/$defs/safeId"
        },
        "artifactScopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "incident_summary",
              "log_excerpts",
              "trace_ids",
              "metrics_window",
              "deploy_diffs",
              "repro_steps",
              "artifact_digests"
            ]
          }
        },
        "maxArtifactBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 10485760
        },
        "expiryHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "requiresDigestVerification": {
          "const": true
        },
        "audited": {
          "const": true
        }
      }
    },
    "devopsRunbook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "objective",
        "skills",
        "requiredTools",
        "steps"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/safeId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "skills": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeId"
          }
        },
        "requiredTools": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeId"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
          }
        }
      }
    },
    "devopsFirstTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "environment",
        "allowedActions",
        "acceptanceCriteria"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "environment": {
          "$ref": "#/$defs/safeId"
        },
        "allowedActions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "read",
              "plan"
            ]
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "devopsLane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "laneId",
        "environments",
        "runbooks",
        "approval"
      ],
      "properties": {
        "laneId": {
          "$ref": "#/$defs/safeId"
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeId"
          }
        },
        "runbooks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeId"
          }
        },
        "approval": {
          "enum": [
            "owner",
            "two_person"
          ]
        }
      }
    }
  }
}
