          "$ref": "https://warpmetal.com/contracts/workspace-workflow-budget-v2.schema.json#/$defs/time"
        },
        "providerPolicyDigest": {
          "const": "sha256:e3020419b9841fb1e39c9dca0ff262c8761c19438263187c90b86b89976e9657"
        },
        "accountingVersion": {
          "type": "integer",
          "const": 2
        },
        "artifactReads": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactAuthority"
          }
        }
      }
    },
