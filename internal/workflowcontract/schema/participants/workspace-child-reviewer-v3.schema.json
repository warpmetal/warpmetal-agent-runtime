        },
        "applicability": {
          "$ref": "https://api.warpmetal.com/contracts/workspace-workflow-budget-v5.schema.json#/$defs/artifactApplicability2"
        },
        "qualification": {
          "$ref": "https://warpmetal.com/contracts/workspace-child-product-v1.schema.json#/$defs/qualificationPin"
        },
        "reservation": {
          "$ref": "https://api.warpmetal.com/contracts/workspace-workflow-budget-v5.schema.json#/$defs/reservation"
        },
        "budget": {
          "$ref": "https://warpmetal.com/contracts/workspace-child-product-v1.schema.json#/$defs/budget"
        },
        "workload": {
          "allOf": [
            {
              "$ref": "https://warpmetal.com/contracts/workspace-child-product-v1.schema.json#/$defs/workload"
            },
            {
              "properties": {
                "kind": {
                  "const": "review1"
                }
              }
            }
          ]
        },
        "instructions": {
          "$ref": "https://warpmetal.com/contracts/workspace-child-product-v1.schema.json#/$defs/instructionPin"
        },
        "preparedReceipt": {
          "$ref": "https://api.warpmetal.com/contracts/cell-lifecycle-v3.schema.json#/$defs/preparedReceipt"
        },
        "binding": {
          "$ref": "https://warpmetal.com/contracts/workspace-workflow-v1.schema.json#/$defs/binding"
        },
        "assignment": {
          "$ref": "https://warpmetal.com/contracts/workspace-workflow-v1.schema.json#/$defs/assignmentReceipt"
        },
        "sourceReads": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/physicalSourceScope"
          }
        },
        "tools": {
