{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.warpmetal.com/contracts/workspace-provider-readback-v4.schema.json",
  "title": "Authenticated backend original provider ledger prefix; not a Runtime observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "authorityDigest",
    "opening",
    "reservations",
    "settlements",
    "snapshot",
    "participantInventoryDigest"
  ],
  "properties": {
    "formatVersion": {
      "const": 3
    },
    "authorityDigest": {
      "$ref": "https://api.warpmetal.com/contracts/workspace-provider-accounting-v4.schema.json#/$defs/digest"
    },
    "opening": {
      "$ref": "https://api.warpmetal.com/contracts/workspace-provider-accounting-v4.schema.json#/$defs/openingHandshake3"
    },
    "reservations": {
      "type": "array",
      "maxItems": 21,
      "items": {
        "$ref": "https://api.warpmetal.com/contracts/workspace-provider-accounting-v4.schema.json#/$defs/reservation3"
      },
      "uniqueItems": true
    },
    "settlements": {
      "type": "array",
      "maxItems": 21,
      "items": {
        "$ref": "https://api.warpmetal.com/contracts/workspace-provider-accounting-v4.schema.json#/$defs/settlementEnvelope3"
      },
      "uniqueItems": true
    },
    "snapshot": {
      "$ref": "https://api.warpmetal.com/contracts/workspace-provider-accounting-v4.schema.json#/$defs/ledgerSnapshot"
    },
    "participantInventoryDigest": {
      "$ref": "https://api.warpmetal.com/contracts/workspace-provider-accounting-v4.schema.json#/$defs/digest"
    }
  }
}
