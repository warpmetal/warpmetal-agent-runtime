  "$comment": "GET /internal/account/agent-provider-connections/{connectionId}/qualification-policy with exactly taskId and connectionRevision query fields. Route canonicalizes positive integer revision and applies current owner/task scope before selecting the configured authority family.",
  "$defs": {
    "qualificationPolicySelectionOpenAI1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
