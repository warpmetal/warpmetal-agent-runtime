{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.warpmetal.com/contracts/workspace-provider-originals-v4.schema.json",
  "title": "Reservation-bound provider original settlement ingress; no paths or credential headers",
  "$defs": {
    "original": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "contentBase64"
      ],
      "properties": {
        "digest": {
          "$ref": "https://api.warpmetal.com/contracts/workspace-provider-accounting-v4.schema.json#/$defs/digest"
        },
        "contentBase64": {
          "type": "string",
          "maxLength": 349528,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "originalSettlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "settlement",
        "originals"
      ],
      "properties": {
        "formatVersion": {
          "const": 3
        },
        "settlement": {
          "$ref": "https://api.warpmetal.com/contracts/workspace-provider-accounting-v4.schema.json#/$defs/settlementEnvelope3"
        },
        "originals": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/original"
          }
        }
      }
    }
  },
  "$ref": "#/$defs/originalSettlement"
}
