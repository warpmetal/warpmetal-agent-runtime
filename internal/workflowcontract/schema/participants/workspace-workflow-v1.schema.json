{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://warpmetal.com/contracts/workspace-workflow-v1.schema.json",
 "title":"Workspace workflow v1 — SV2 section 11 single frozen contract",
 "$comment":"Supersedes section 10. Endpoint selects a definition. UTF-8 byte, exact safe-integer, canonical base64, source/STATE/bridge/role verification and immutable current-pin invariants are mandatory in addition to schema validation. No payload grants execution or payment authority.",
 "$defs":{
  "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
  "digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
  "positive":{"type":"integer","minimum":1,"maximum":9007199254740991},
  "nonnegative":{"type":"integer","minimum":0,"maximum":9007199254740991},
  "time":{"type":"string","format":"date-time","pattern":"Z$"},
  "text":{"type":"string","maxLength":2048,"pattern":"^[^\\u0000]*$"},
  "path":{"type":"string","minLength":1,"maxLength":1024,"pattern":"^(?!/)(?!\\s)(?!.*\\s$)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))[^\\\\:#?\\u0000-\\u001f\\u007f]+$"},
  "commit":{"type":"string","pattern":"^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
  "nullableId":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]},
  "nullableDigest":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/digest"}]},
  "paths":{"type":"array","maxItems":64,"uniqueItems":true,"items":{"$ref":"#/$defs/path"}},
  "reference":{"type":"object","additionalProperties":false,"required":["path","sourceDigest","status"],"properties":{
   "path":{"$ref":"#/$defs/path"},"sourceDigest":{"$ref":"#/$defs/digest"},"status":{"enum":["accepted","proposed","unavailable"]}}},
  "references":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/reference"}},
  "planPin":{"type":"object","additionalProperties":false,"required":["workId","workRevision","contentDigest","planRef"],"properties":{
   "workId":{"$ref":"#/$defs/id"},"workRevision":{"$ref":"#/$defs/positive"},"contentDigest":{"$ref":"#/$defs/digest"},"planRef":{"$ref":"#/$defs/reference"}}},
  "resultPin":{"type":"object","additionalProperties":false,"required":["resultId","resultRevision","resultDigest"],"properties":{
   "resultId":{"$ref":"#/$defs/id"},"resultRevision":{"$ref":"#/$defs/positive"},"resultDigest":{"$ref":"#/$defs/digest"}}},
  "nullableResultPin":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/resultPin"}]},
  "receiptRef":{"type":"object","additionalProperties":false,"required":["receiptId","receiptDigest"],"properties":{
   "receiptId":{"$ref":"#/$defs/id"},"receiptDigest":{"$ref":"#/$defs/digest"}}},
  "nullableReceiptRef":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/receiptRef"}]},
  "reviewRef":{"type":"object","additionalProperties":false,"required":["reviewId","reviewDigest"],"properties":{
   "reviewId":{"$ref":"#/$defs/id"},"reviewDigest":{"$ref":"#/$defs/digest"}}},
  "nullableReviewRef":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/reviewRef"}]},
  "contentType":{"enum":["text/plain","text/markdown","text/x-diff","text/csv","application/json","application/octet-stream","image/png","image/jpeg"]},
  "artifactRef":{"type":"object","additionalProperties":false,"required":["artifactId","digest","byteCount","contentType"],"properties":{
   "artifactId":{"$ref":"#/$defs/id"},"digest":{"$ref":"#/$defs/digest"},"byteCount":{"type":"integer","minimum":0,"maximum":8388608},"contentType":{"$ref":"#/$defs/contentType"}}},
  "nullableArtifactRef":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/artifactRef"}]},
  "artifactRefs":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/artifactRef"}},
  "packetRef":{"type":"object","additionalProperties":false,"required":["packetId","packetRevision"],"properties":{
   "packetId":{"$ref":"#/$defs/id"},"packetRevision":{"$ref":"#/$defs/positive"}}},
  "writeScope":{"type":"object","additionalProperties":false,"required":["mode","paths"],"properties":{
   "mode":{"enum":["exclusive","consultation"]},"paths":{"allOf":[{"$ref":"#/$defs/paths"},{"minItems":1}]}}},
  "lane":{"type":"object","additionalProperties":false,"required":["laneId","packetRefs","dependencies","writeScope","requestedParallelism","reason"],"properties":{
   "laneId":{"$ref":"#/$defs/id"},"packetRefs":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/packetRef"}},
   "dependencies":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/packetRef"}},"writeScope":{"$ref":"#/$defs/writeScope"},
   "requestedParallelism":{"$ref":"#/$defs/positive"},"reason":{"$ref":"#/$defs/text"}}},
  "lanes":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/lane"}},
  "binding":{"type":"object","additionalProperties":false,
   "required":["workId","workRevision","bindingId","bindingRevision","executionId","preparationId","parentExecutionId","parentPacketId","packetId","packetRevision","attempt","fence","serviceRegistrationId","serviceGeneration","sandboxGeneration","nativeSessionId","nativeProjectId","nativeLocationDigest","projectId","workspaceEpoch","selectionId","scopeRevision","rootAttestation","instructionRevision","instructionDigest","profileDigest","configDigest"],
   "properties":{"workId":{"$ref":"#/$defs/id"},"workRevision":{"$ref":"#/$defs/positive"},"bindingId":{"$ref":"#/$defs/id"},"bindingRevision":{"$ref":"#/$defs/positive"},
    "executionId":{"$ref":"#/$defs/id"},"preparationId":{"$ref":"#/$defs/id"},"parentExecutionId":{"$ref":"#/$defs/nullableId"},"parentPacketId":{"$ref":"#/$defs/nullableId"},
    "packetId":{"$ref":"#/$defs/id"},"packetRevision":{"$ref":"#/$defs/positive"},"attempt":{"$ref":"#/$defs/positive"},"fence":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "serviceRegistrationId":{"$ref":"#/$defs/id"},"serviceGeneration":{"$ref":"#/$defs/positive"},"sandboxGeneration":{"$ref":"#/$defs/positive"},"nativeSessionId":{"$ref":"#/$defs/id"},
    "nativeProjectId":{"type":"string","pattern":"^(?:global|[a-f0-9]{40})$"},"nativeLocationDigest":{"$ref":"#/$defs/digest"},"projectId":{"$ref":"#/$defs/id"},"workspaceEpoch":{"$ref":"#/$defs/id"},
    "selectionId":{"$ref":"#/$defs/id"},"scopeRevision":{"$ref":"#/$defs/positive"},"rootAttestation":{"$ref":"#/$defs/digest"},"instructionRevision":{"$ref":"#/$defs/positive"},
    "instructionDigest":{"$ref":"#/$defs/digest"},"profileDigest":{"$ref":"#/$defs/digest"},"configDigest":{"$ref":"#/$defs/digest"}},
   "allOf":[{"if":{"properties":{"parentExecutionId":{"type":"null"}}},"then":{"properties":{"parentPacketId":{"type":"null"}}},"else":{"properties":{"parentPacketId":{"$ref":"#/$defs/id"}}}}]},
  "assignmentRequest":{"type":"object","additionalProperties":false,"required":["formatVersion","requestId","binding","plan","purpose","target"],"properties":{
   "formatVersion":{"type":"integer","const":1},"requestId":{"$ref":"#/$defs/id"},"binding":{"$ref":"#/$defs/binding"},"plan":{"$ref":"#/$defs/planPin"},"purpose":{"enum":["implement","review","integrate"]},"target":{"$ref":"#/$defs/nullableResultPin"}},
   "allOf":[{"if":{"properties":{"purpose":{"const":"implement"}}},"then":{"properties":{"target":{"type":"null"}}},"else":{"properties":{"target":{"$ref":"#/$defs/resultPin"}}}}]},
  "adviceRequest":{"type":"object","additionalProperties":false,"required":["formatVersion","requestId","plan","lanes","reason"],"properties":{
   "formatVersion":{"type":"integer","const":1},"requestId":{"$ref":"#/$defs/id"},"plan":{"$ref":"#/$defs/planPin"},"lanes":{"allOf":[{"$ref":"#/$defs/lanes"},{"minItems":1}]},"reason":{"$ref":"#/$defs/text"}}},
  "adviceDecisionRequest":{"type":"object","additionalProperties":false,"required":["formatVersion","requestId","expectedAdviceRevision","plan","choice","lanes","reason"],"properties":{
   "formatVersion":{"type":"integer","const":1},"requestId":{"$ref":"#/$defs/id"},"expectedAdviceRevision":{"$ref":"#/$defs/positive"},"plan":{"$ref":"#/$defs/planPin"},"choice":{"enum":["adopt","change","decline"]},"lanes":{"$ref":"#/$defs/lanes"},"reason":{"$ref":"#/$defs/text"}},
   "allOf":[{"if":{"properties":{"choice":{"const":"decline"}}},"then":{"properties":{"lanes":{"maxItems":0}}},"else":{"properties":{"lanes":{"minItems":1}}}}]},
  "artifactRequest":{"type":"object","additionalProperties":false,"required":["formatVersion","requestId","binding","sourcePath","purpose","contentType","byteCount","digest","content","nativeReadReceipt"],"properties":{
   "formatVersion":{"type":"integer","const":1},"requestId":{"$ref":"#/$defs/id"},"binding":{"$ref":"#/$defs/binding"},"sourcePath":{"$ref":"#/$defs/path"},
   "purpose":{"enum":["patch","document","analysis","data","script","tool_output","review_evidence"]},"contentType":{"$ref":"#/$defs/contentType"},"byteCount":{"type":"integer","minimum":0,"maximum":8388608},
   "digest":{"$ref":"#/$defs/digest"},"content":{"type":"string","maxLength":11184812,"contentEncoding":"base64"},"nativeReadReceipt":{"$ref":"#/$defs/receiptRef"}}},
  "consumedRef":{"type":"object","additionalProperties":false,"required":["reference","readReceipt"],"properties":{"reference":{"$ref":"#/$defs/reference"},"readReceipt":{"$ref":"#/$defs/receiptRef"}}},
  "consumedRefs":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/consumedRef"}},
  "output":{"oneOf":[
   {"type":"object","additionalProperties":false,"required":["type","sourceRef","baseCommit","changedPaths","patch","summary"],"properties":{
    "type":{"const":"coding"},"sourceRef":{"$ref":"#/$defs/reference"},"baseCommit":{"$ref":"#/$defs/commit"},"changedPaths":{"allOf":[{"$ref":"#/$defs/paths"},{"minItems":1}]},"patch":{"$ref":"#/$defs/artifactRef"},"summary":{"$ref":"#/$defs/nullableArtifactRef"}}},
   {"type":"object","additionalProperties":false,"required":["type","sourceRefs","method","output"],"properties":{
    "type":{"enum":["document","analysis"]},"sourceRefs":{"$ref":"#/$defs/references"},"method":{"$ref":"#/$defs/text"},"output":{"$ref":"#/$defs/artifactRef"}}},
   {"type":"object","additionalProperties":false,"required":["type","inputs","script","output"],"properties":{
    "type":{"const":"data"},"inputs":{"allOf":[{"$ref":"#/$defs/artifactRefs"},{"minItems":1}]},"script":{"$ref":"#/$defs/artifactRef"},"output":{"$ref":"#/$defs/artifactRef"}}},
   {"type":"object","additionalProperties":false,"required":["type","toolReceipt","output"],"properties":{
    "type":{"const":"tool"},"toolReceipt":{"$ref":"#/$defs/receiptRef"},"output":{"$ref":"#/$defs/artifactRef"}}}
  ]},
  "result":{"type":"object","additionalProperties":false,"required":["outcome","consumedRefs","mismatches","stateEvidence","outputs","effectReceipts","remainingWork"],"properties":{
   "outcome":{"enum":["completed","failed","waiting_for_input","reconcile_required"]},"consumedRefs":{"$ref":"#/$defs/consumedRefs"},
   "mismatches":{"type":"array","maxItems":64,"items":{"type":"object","additionalProperties":false,"required":["reference","code","detail"],"properties":{"reference":{"$ref":"#/$defs/reference"},"code":{"enum":["missing","digest_mismatch","state_mismatch","scope_denied"]},"detail":{"$ref":"#/$defs/text"}}}},
   "stateEvidence":{"type":"array","maxItems":64,"items":{"type":"object","additionalProperties":false,"required":["state","disposition","evidence"],"properties":{"state":{"$ref":"#/$defs/text"},"disposition":{"enum":["preserved","updated","unavailable"]},"evidence":{"$ref":"#/$defs/nullableArtifactRef"}},
    "allOf":[{"if":{"properties":{"disposition":{"const":"unavailable"}}},"then":{},"else":{"properties":{"evidence":{"$ref":"#/$defs/artifactRef"}}}}]}},
   "outputs":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/output"}},"effectReceipts":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/receiptRef"}},"remainingWork":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/text"}}},
   "allOf":[{"if":{"properties":{"outcome":{"const":"completed"}}},"then":{"properties":{"outputs":{"minItems":1},"mismatches":{"maxItems":0}}}}]},
  "resultRequest":{"type":"object","additionalProperties":false,"required":["formatVersion","requestId","binding","assignmentId","result"],"properties":{
   "formatVersion":{"type":"integer","const":1},"requestId":{"$ref":"#/$defs/id"},"binding":{"$ref":"#/$defs/binding"},"assignmentId":{"$ref":"#/$defs/id"},"result":{"$ref":"#/$defs/result"}}},
  "reviewRequest":{"type":"object","additionalProperties":false,"required":["formatVersion","requestId","binding","assignmentId","target","integration","reviewedArtifacts","consumedRefs","disposition","findings","evidence"],"properties":{
   "formatVersion":{"type":"integer","const":1},"requestId":{"$ref":"#/$defs/id"},"binding":{"$ref":"#/$defs/binding"},"assignmentId":{"$ref":"#/$defs/id"},"target":{"$ref":"#/$defs/resultPin"},"integration":{"$ref":"#/$defs/receiptRef"},
   "reviewedArtifacts":{"$ref":"#/$defs/artifactRefs"},"consumedRefs":{"$ref":"#/$defs/consumedRefs"},"disposition":{"enum":["approve","changes_required"]},
   "findings":{"type":"array","maxItems":64,"items":{"type":"object","additionalProperties":false,"required":["code","artifactId","path","summary"],"properties":{
    "code":{"enum":["contract_mismatch","specimen_mismatch","scope_violation","missing_evidence","incorrect_output"]},"artifactId":{"$ref":"#/$defs/nullableId"},"path":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/path"}]},"summary":{"$ref":"#/$defs/text"}}}},
   "evidence":{"allOf":[{"$ref":"#/$defs/artifactRefs"},{"minItems":1}]}},
   "allOf":[{"if":{"properties":{"disposition":{"const":"approve"}}},"then":{"properties":{"findings":{"maxItems":0}}}}]},
  "observation":{"oneOf":[
   {"type":"object","additionalProperties":false,"required":["type","reference","observedDigest","byteCount"],"properties":{
    "type":{"const":"source_read"},"reference":{"$ref":"#/$defs/reference"},"observedDigest":{"$ref":"#/$defs/digest"},"byteCount":{"type":"integer","minimum":0,"maximum":8388608}}},
   {"type":"object","additionalProperties":false,"required":["type","sourcePath","digest","byteCount"],"properties":{
    "type":{"const":"artifact_read"},"sourcePath":{"$ref":"#/$defs/path"},"digest":{"$ref":"#/$defs/digest"},"byteCount":{"type":"integer","minimum":0,"maximum":8388608}}},
   {"type":"object","additionalProperties":false,"required":["type","connectorId","connectorRevision","toolId","scopeRevision","dataScopeDigest","action","inputDigest","output","outcome","status"],"properties":{
    "type":{"const":"mcp_read"},"connectorId":{"$ref":"#/$defs/id"},"connectorRevision":{"$ref":"#/$defs/positive"},"toolId":{"$ref":"#/$defs/id"},"scopeRevision":{"$ref":"#/$defs/positive"},
    "dataScopeDigest":{"$ref":"#/$defs/digest"},"action":{"const":"read"},"inputDigest":{"$ref":"#/$defs/digest"},"output":{"$ref":"#/$defs/nullableArtifactRef"},"outcome":{"enum":["succeeded","failed","unknown"]},"status":{"enum":["settled","unknown"]}},
    "allOf":[{"if":{"properties":{"status":{"const":"settled"}}},"then":{"properties":{"output":{"$ref":"#/$defs/artifactRef"},"outcome":{"enum":["succeeded","failed"]}}}},{"if":{"properties":{"outcome":{"const":"unknown"}}},"then":{"properties":{"status":{"const":"unknown"}}}}]},
   {"type":"object","additionalProperties":false,"required":["type","inputs","script","argvDigest","output","exitCode","status"],"properties":{
    "type":{"const":"script_run"},"inputs":{"$ref":"#/$defs/artifactRefs"},"script":{"$ref":"#/$defs/artifactRef"},"argvDigest":{"$ref":"#/$defs/digest"},"output":{"$ref":"#/$defs/nullableArtifactRef"},
    "exitCode":{"type":["integer","null"],"minimum":-2147483648,"maximum":2147483647},"status":{"enum":["settled","unknown"]}},
    "allOf":[{"if":{"properties":{"status":{"const":"settled"}}},"then":{"properties":{"exitCode":{"type":"integer"}}}}]},
   {"type":"object","additionalProperties":false,"required":["type","assignmentId","target","targetBinding","artifacts","consumedRefs","beforeDigest","afterDigest","changedPaths","outcome","status"],"properties":{
    "type":{"const":"integration"},"assignmentId":{"$ref":"#/$defs/id"},"target":{"$ref":"#/$defs/resultPin"},"targetBinding":{"$ref":"#/$defs/binding"},"artifacts":{"allOf":[{"$ref":"#/$defs/artifactRefs"},{"minItems":1}]},
    "consumedRefs":{"$ref":"#/$defs/consumedRefs"},"beforeDigest":{"$ref":"#/$defs/digest"},"afterDigest":{"$ref":"#/$defs/nullableDigest"},"changedPaths":{"$ref":"#/$defs/paths"},"outcome":{"enum":["succeeded","failed","unknown"]},"status":{"enum":["settled","unknown"]}},
    "allOf":[{"if":{"properties":{"outcome":{"const":"unknown"}}},"then":{"properties":{"status":{"const":"unknown"}}},"else":{"properties":{"afterDigest":{"$ref":"#/$defs/digest"}}}},{"if":{"properties":{"status":{"const":"settled"}}},"then":{"properties":{"outcome":{"enum":["succeeded","failed"]},"afterDigest":{"$ref":"#/$defs/digest"}}}}]}
  ]},
  "observationRequest":{"type":"object","additionalProperties":false,"required":["formatVersion","requestId","binding","reconciles","observation"],"properties":{
   "formatVersion":{"type":"integer","const":1},"requestId":{"$ref":"#/$defs/id"},"binding":{"$ref":"#/$defs/binding"},"reconciles":{"$ref":"#/$defs/nullableReceiptRef"},"observation":{"$ref":"#/$defs/observation"}}},
  "resultDecisionRequest":{"type":"object","additionalProperties":false,"required":["formatVersion","requestId","target","plan","expectedDecisionRevision","decision","review","integration","reason"],"properties":{
   "formatVersion":{"type":"integer","const":1},"requestId":{"$ref":"#/$defs/id"},"target":{"$ref":"#/$defs/resultPin"},"plan":{"$ref":"#/$defs/planPin"},"expectedDecisionRevision":{"$ref":"#/$defs/nonnegative"},"decision":{"enum":["accept","reject","hold"]},"review":{"$ref":"#/$defs/nullableReviewRef"},"integration":{"$ref":"#/$defs/nullableReceiptRef"},"reason":{"$ref":"#/$defs/text"}},
   "allOf":[{"if":{"properties":{"decision":{"const":"accept"}}},"then":{"properties":{"review":{"$ref":"#/$defs/reviewRef"},"integration":{"$ref":"#/$defs/receiptRef"}}},"else":{"properties":{"integration":{"type":"null"}}}}]},
  "peerScope":{"enum":["plan_consultation","contract_consultation","result_consultation"]},
  "peerEndpoint":{"type":"object","additionalProperties":false,"required":["cellId","serverId","taskId","sandboxId","sandboxGeneration","orchestratorBindingId","orchestratorBindingRevision","controllerId","controllerRevision","authorityRevision","serviceRegistrationId","serviceGeneration","nativeSessionId"],"properties":{
   "cellId":{"$ref":"#/$defs/id"},"serverId":{"$ref":"#/$defs/id"},"taskId":{"$ref":"#/$defs/id"},"sandboxId":{"$ref":"#/$defs/id"},"sandboxGeneration":{"$ref":"#/$defs/positive"},"orchestratorBindingId":{"$ref":"#/$defs/id"},"orchestratorBindingRevision":{"$ref":"#/$defs/positive"},"controllerId":{"$ref":"#/$defs/id"},"controllerRevision":{"$ref":"#/$defs/positive"},"authorityRevision":{"$ref":"#/$defs/positive"},"serviceRegistrationId":{"$ref":"#/$defs/id"},"serviceGeneration":{"$ref":"#/$defs/positive"},"nativeSessionId":{"$ref":"#/$defs/id"}}},
  "peerGrantRequest":{"type":"object","additionalProperties":false,"required":["formatVersion","requestId","expectedRevision","enabled","scopes"],"properties":{
   "formatVersion":{"type":"integer","const":1},"requestId":{"$ref":"#/$defs/id"},"expectedRevision":{"$ref":"#/$defs/nonnegative"},"enabled":{"type":"boolean"},"scopes":{"type":"array","maxItems":3,"uniqueItems":true,"items":{"$ref":"#/$defs/peerScope"}}},
   "allOf":[{"if":{"properties":{"enabled":{"const":true}}},"then":{"properties":{"scopes":{"minItems":1}}},"else":{"properties":{"scopes":{"maxItems":0}}}}]},
  "peerArtifactRefs":{"allOf":[{"$ref":"#/$defs/artifactRefs"},{"maxItems":8}]},
  "peerRequest":{"type":"object","additionalProperties":false,"required":["formatVersion","requestId","destinationCellId","scope","expiresAt","question","artifactRefs"],"properties":{
   "formatVersion":{"type":"integer","const":1},"requestId":{"$ref":"#/$defs/id"},"destinationCellId":{"$ref":"#/$defs/id"},"scope":{"$ref":"#/$defs/peerScope"},"expiresAt":{"$ref":"#/$defs/time"},"question":{"type":"string","minLength":1,"maxLength":4096,"pattern":"^[^\\u0000]*$"},"artifactRefs":{"$ref":"#/$defs/peerArtifactRefs"}}},
  "assignmentReceipt":{"type":"object","additionalProperties":false,"required":["formatVersion","assignmentId","assignmentDigest","executionId","purpose","plan","target","createdAt"],"properties":{
   "formatVersion":{"const":1},"assignmentId":{"$ref":"#/$defs/id"},"assignmentDigest":{"$ref":"#/$defs/digest"},"executionId":{"$ref":"#/$defs/id"},"purpose":{"enum":["implement","review","integrate"]},"plan":{"$ref":"#/$defs/planPin"},"target":{"$ref":"#/$defs/nullableResultPin"},"createdAt":{"$ref":"#/$defs/time"}}},
  "adviceReceipt":{"type":"object","additionalProperties":false,"required":["formatVersion","adviceId","adviceRevision","adviceDigest","plan","createdAt"],"properties":{
   "formatVersion":{"const":1},"adviceId":{"$ref":"#/$defs/id"},"adviceRevision":{"type":"integer","const":1},"adviceDigest":{"$ref":"#/$defs/digest"},"plan":{"$ref":"#/$defs/planPin"},"createdAt":{"$ref":"#/$defs/time"}}},
  "adviceDecisionReceipt":{"type":"object","additionalProperties":false,"required":["formatVersion","decisionId","decisionRevision","adviceId","plan","choice","decisionDigest","createdAt"],"properties":{
   "formatVersion":{"const":1},"decisionId":{"$ref":"#/$defs/id"},"decisionRevision":{"type":"integer","const":1},"adviceId":{"$ref":"#/$defs/id"},"plan":{"$ref":"#/$defs/planPin"},"choice":{"enum":["adopt","change","decline"]},"decisionDigest":{"$ref":"#/$defs/digest"},"createdAt":{"$ref":"#/$defs/time"}}},
  "artifactReceipt":{"type":"object","additionalProperties":false,"required":["formatVersion","artifactId","executionId","sourcePath","purpose","digest","byteCount","contentType","nativeReadReceipt","artifactReceiptDigest","createdAt"],"properties":{
   "formatVersion":{"const":1},"artifactId":{"$ref":"#/$defs/id"},"executionId":{"$ref":"#/$defs/id"},"sourcePath":{"$ref":"#/$defs/path"},"purpose":{"enum":["patch","document","analysis","data","script","tool_output","review_evidence"]},"digest":{"$ref":"#/$defs/digest"},"byteCount":{"type":"integer","minimum":0,"maximum":8388608},"contentType":{"$ref":"#/$defs/contentType"},"nativeReadReceipt":{"$ref":"#/$defs/receiptRef"},"artifactReceiptDigest":{"$ref":"#/$defs/digest"},"createdAt":{"$ref":"#/$defs/time"}}},
  "resultReceipt":{"type":"object","additionalProperties":false,"required":["formatVersion","resultId","resultRevision","resultDigest","executionId","assignmentId","state","createdAt"],"properties":{
   "formatVersion":{"const":1},"resultId":{"$ref":"#/$defs/id"},"resultRevision":{"type":"integer","const":1},"resultDigest":{"$ref":"#/$defs/digest"},"executionId":{"$ref":"#/$defs/id"},"assignmentId":{"$ref":"#/$defs/id"},"state":{"const":"reported"},"createdAt":{"$ref":"#/$defs/time"}}},
  "reviewReceipt":{"type":"object","additionalProperties":false,"required":["formatVersion","reviewId","reviewDigest","target","integration","reviewerExecutionId","disposition","createdAt"],"properties":{
   "formatVersion":{"const":1},"reviewId":{"$ref":"#/$defs/id"},"reviewDigest":{"$ref":"#/$defs/digest"},"target":{"$ref":"#/$defs/resultPin"},"integration":{"$ref":"#/$defs/receiptRef"},"reviewerExecutionId":{"$ref":"#/$defs/id"},"disposition":{"enum":["approve","changes_required"]},"createdAt":{"$ref":"#/$defs/time"}}},
  "observationReceipt":{"type":"object","additionalProperties":false,"required":["formatVersion","receiptId","receiptDigest","executionId","type","status","createdAt"],"properties":{
   "formatVersion":{"const":1},"receiptId":{"$ref":"#/$defs/id"},"receiptDigest":{"$ref":"#/$defs/digest"},"executionId":{"$ref":"#/$defs/id"},"type":{"enum":["source_read","artifact_read","mcp_read","script_run","integration"]},"status":{"enum":["settled","unknown"]},"createdAt":{"$ref":"#/$defs/time"}}},
  "decisionReceipt":{"type":"object","additionalProperties":false,"required":["formatVersion","decisionId","decisionRevision","target","plan","decision","review","integration","decisionDigest","createdAt"],"properties":{
   "formatVersion":{"const":1},"decisionId":{"$ref":"#/$defs/id"},"decisionRevision":{"$ref":"#/$defs/positive"},"target":{"$ref":"#/$defs/resultPin"},"plan":{"$ref":"#/$defs/planPin"},"decision":{"enum":["accept","reject","hold"]},"review":{"$ref":"#/$defs/nullableReviewRef"},"integration":{"$ref":"#/$defs/nullableReceiptRef"},"decisionDigest":{"$ref":"#/$defs/digest"},"createdAt":{"$ref":"#/$defs/time"}},
   "allOf":[{"if":{"properties":{"decision":{"const":"accept"}}},"then":{"properties":{"review":{"$ref":"#/$defs/reviewRef"},"integration":{"$ref":"#/$defs/receiptRef"}}},"else":{"properties":{"integration":{"type":"null"}}}}]},
  "resultDetail":{"type":"object","additionalProperties":false,"required":["formatVersion","receipt","binding","assignmentId","result","latestDecision"],"properties":{
   "formatVersion":{"const":1},"receipt":{"$ref":"#/$defs/resultReceipt"},"binding":{"$ref":"#/$defs/binding"},"assignmentId":{"$ref":"#/$defs/id"},"result":{"$ref":"#/$defs/result"},"latestDecision":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/decisionReceipt"}]}}},
  "adviceDetail":{"type":"object","additionalProperties":false,"required":["formatVersion","receipt","lanes","reason","decision"],"properties":{
   "formatVersion":{"const":1},"receipt":{"$ref":"#/$defs/adviceReceipt"},"lanes":{"$ref":"#/$defs/lanes"},"reason":{"$ref":"#/$defs/text"},"decision":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["receipt","lanes","reason"],"properties":{"receipt":{"$ref":"#/$defs/adviceDecisionReceipt"},"lanes":{"$ref":"#/$defs/lanes"},"reason":{"$ref":"#/$defs/text"}}}]}}},
