        },
        "accountingVersion": {
          "type": "integer",
          "const": 2
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "business_worker"
              }
            }
          },
          "then": {
            "properties": {
              "modelRequests": {
                "const": 3
              },
              "usdMicros": {
                "const": 1263000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "purpose": {
                "enum": [
                  "coding_worker",
                  "integrator"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "modelRequests": {
                "const": 2
              },
              "usdMicros": {
                "const": 842000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "reviewer"
              }
            }
          },
          "then": {
            "properties": {
              "modelRequests": {
                "const": 1
              },
              "usdMicros": {
