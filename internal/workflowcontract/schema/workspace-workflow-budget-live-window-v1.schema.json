{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://warpmetal.com/contracts/workspace-workflow-budget-live-window-v1.schema.json",
  "title":"Package4 additive LIVE current-window admission; original budget schemas unchanged",
  "$defs":{
    "validationWindow":{
      "type":"object","additionalProperties":false,"required":["openedAt","totalUsdMicros"],
      "properties":{"openedAt":{"type":"string","const":"2026-10-10T02:27:52Z"},"totalUsdMicros":{"type":"integer","const":30000000}}
    },
    "authority2":{
      "type":"object","additionalProperties":false,
      "required":["formatVersion","caseId","caseManifestDigest","usdLimitMicros","requestLimit","turnLimit","backend","native","runtime","sandbox","profileBundleDigest","pricing","operator","producer","evidenceRoot","case","evidenceClass","tupleInventory","ledgerReconciliation","validationWindow"],
      "properties":{
        "formatVersion":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/authority2/properties/formatVersion"},
        "caseId":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/id"},
        "caseManifestDigest":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/digest"},
        "usdLimitMicros":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/authority2/properties/usdLimitMicros"},
        "requestLimit":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/authority2/properties/requestLimit"},
        "turnLimit":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/authority2/properties/turnLimit"},
        "backend":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/authority2/properties/backend"},
        "native":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/authority2/properties/native"},
        "runtime":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/authority2/properties/runtime"},
        "sandbox":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/authority2/properties/sandbox"},
        "profileBundleDigest":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/digest"},
        "pricing":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/authority2/properties/pricing"},
        "operator":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/keyIdentity"},
        "producer":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/producerIdentity"},
        "evidenceRoot":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/authority2/properties/evidenceRoot"},
        "case":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/selectedCase26"},
        "evidenceClass":{"const":"live"},
        "tupleInventory":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/tupleInventory"},
        "ledgerReconciliation":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/ledgerReconciliation"},
        "validationWindow":{"$ref":"#/$defs/validationWindow"}
      }
    },
    "selectedManifest26Envelope":{
      "type":"object","additionalProperties":false,"required":["payload","keyId","signature"],
      "properties":{"payload":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/selectedManifest26"},"keyId":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/id"},"signature":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/signature"}}
    },
    "ledgerProjection":{
      "type":"object","additionalProperties":false,
      "required":["ledgerId","identityDigest","observedAt","physicalRequests","modelRequests","preparations","reservedUsdMicros","actualUsdMicros","unknownUsdMicros"],
      "properties":{
        "ledgerId":{"const":"model-qualification-and-product"},
        "identityDigest":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/digest"},
        "observedAt":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/time"},
        "physicalRequests":{"type":"integer","minimum":0},"modelRequests":{"type":"integer","minimum":0},"preparations":{"type":"integer","minimum":0},
        "reservedUsdMicros":{"type":"integer","minimum":0},"actualUsdMicros":{"type":"integer","minimum":0},"unknownUsdMicros":{"type":"integer","minimum":0}
      }
    },
    "currentWindowReconciliation":{
      "type":"object","additionalProperties":false,
      "required":["formatVersion","purpose","validationWindow","candidateInventoryDigest","selectionDigest","ledger","openingReceiptDigest","continuationReceiptDigests","notAfter"],
      "properties":{
        "formatVersion":{"type":"integer","const":1},"purpose":{"const":"current_validation_window_reconciliation"},
        "validationWindow":{"$ref":"#/$defs/validationWindow"},
        "candidateInventoryDigest":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/digest"},
        "selectionDigest":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/digest"},
        "ledger":{"$ref":"#/$defs/ledgerProjection"},
        "openingReceiptDigest":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/digest"},
        "continuationReceiptDigests":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/digest"}},
        "notAfter":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/time"}
      }
    },
    "currentWindowReconciliationEnvelope":{
      "type":"object","additionalProperties":false,"required":["payload","keyId","signature"],
      "properties":{"payload":{"$ref":"#/$defs/currentWindowReconciliation"},"keyId":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/id"},"signature":{"$ref":"workspace-workflow-budget-v2.schema.json#/$defs/signature"}}
    }
  }
}
