        "intent": {
          "$ref": "https://warpmetal.com/contracts/workspace-workflow-manager-v1.proposal.schema.json#/$defs/intentRef"
        },
        "binding": {
          "$ref": "https://warpmetal.com/contracts/workspace-workflow-v1.schema.json#/$defs/binding"
        },
        "assignment": {
          "$ref": "https://warpmetal.com/contracts/workspace-workflow-v1.schema.json#/$defs/assignmentReceipt"
        },
        "target": {
          "$ref": "https://warpmetal.com/contracts/workspace-workflow-v1.schema.json#/$defs/resultPin"
        },
        "targetBinding": {
          "$ref": "https://warpmetal.com/contracts/workspace-workflow-v1.schema.json#/$defs/binding"
        },
        "inputId": {
          "$ref": "https://api.warpmetal.com/contracts/cell-lifecycle-v3.schema.json#/$defs/nativeInputId"
        },
        "inputDigest": {
          "$ref": "https://warpmetal.com/contracts/workspace-child-product-v1.schema.json#/$defs/digest"
        },
        "inputByteCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "spans": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/integrationByteSpan"
          },
          "contains": {
            "properties": {
              "kind": {
                "const": "target_artifact"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        "notAfter": {
          "$ref": "https://warpmetal.com/contracts/workspace-child-product-v1.schema.json#/$defs/time"
        }
      }
    },
