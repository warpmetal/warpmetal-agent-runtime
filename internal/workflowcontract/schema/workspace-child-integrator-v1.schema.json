          "$ref": "https://warpmetal.com/contracts/workspace-child-product-v1.schema.json#/$defs/time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assignmentDigest": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "inputs": {
                "properties": {
                  "sourceReads": {
                    "maxItems": 0
                  },
                  "integrationDelivery": {
                    "const": null
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "inputs": {
                "properties": {
                  "sourceReads": {
                    "minItems": 1
                  },
                  "integrationDelivery": {
                    "$ref": "#/$defs/integrationDelivery"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "installedInputEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload",
        "keyId",
        "signature"
      ],
      "properties": {
        "payload": {
          "$ref": "#/$defs/installedInputObservation"
        },
        "keyId": {
          "$ref": "https://warpmetal.com/contracts/workspace-workflow-budget-v2.schema.json#/$defs/id"
        },
        "signature": {
          "$ref": "https://warpmetal.com/contracts/workspace-workflow-budget-v2.schema.json#/$defs/signature"
        }
      }
    },
    "baseProductPolicy": {
      "allOf": [
        {
          "$ref": "https://warpmetal.com/contracts/workspace-child-provider-v2.schema.json#/$defs/productPolicy"
        },
        {
          "properties": {
            "purpose": {
              "enum": [
                "coding_worker",
                "business_worker",
                "reviewer"
              ]
            }
          }
        }
      ]
    },
    "selectedProductPolicy": {
      "oneOf": [
        {
          "$ref": "#/$defs/baseProductPolicy"
        },
        {
          "$ref": "#/$defs/productPolicy"
        }
      ]
    },
    "baseControlGeneration": {
      "allOf": [
        {
          "$ref": "https://warpmetal.com/contracts/workspace-child-provider-v2.schema.json#/$defs/controlGeneration"
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "execute"
              }
            }
          },
          "then": {
            "properties": {
              "policy": {
                "properties": {
                  "payload": {
                    "$ref": "#/$defs/baseProductPolicy"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "selectedControlGeneration": {
      "oneOf": [
        {
          "$ref": "#/$defs/baseControlGeneration"
        },
        {
          "$ref": "#/$defs/controlGeneration"
        }
      ]
    },
    "selectedControlDelivery": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "https://warpmetal.com/contracts/workspace-child-provider-v2.schema.json#/$defs/controlDelivery"
            },
            {
              "properties": {
                "generation": {
                  "$ref": "#/$defs/baseControlGeneration"
                }
              }
            }
          ]
        },
        {
          "$ref": "#/$defs/controlDelivery"
        }
      ]
    }
  }
}
