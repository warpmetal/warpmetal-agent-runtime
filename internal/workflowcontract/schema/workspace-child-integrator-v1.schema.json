    "integrationSourceGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "binding",
        "assignmentId",
        "use",
        "reference",
        "artifact",
        "byteCount",
        "rootGrantDigest",
        "manifestDigest",
        "target",
        "targetBinding",
        "expiresAt"
      ],
      "properties": {
        "formatVersion": {
          "type": "integer",
          "const": 2
        },
        "binding": {
          "$ref": "https://warpmetal.com/contracts/workspace-workflow-v1.schema.json#/$defs/binding"
        },
        "assignmentId": {
          "$ref": "https://warpmetal.com/contracts/workspace-child-product-v1.schema.json#/$defs/id"
        },
        "use": {
          "enum": [
            "integration_packet_source",
            "integration_target_artifact"
          ]
        },
        "reference": {
          "$ref": "https://warpmetal.com/contracts/workspace-workflow-v1.schema.json#/$defs/reference"
        },
        "artifact": {
          "$ref": "https://warpmetal.com/contracts/workspace-workflow-v1.schema.json#/$defs/nullableArtifactRef"
        },
        "byteCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "rootGrantDigest": {
          "$ref": "https://warpmetal.com/contracts/workspace-child-product-v1.schema.json#/$defs/digest"
        },
        "manifestDigest": {
          "$ref": "https://warpmetal.com/contracts/workspace-child-product-v1.schema.json#/$defs/digest"
        },
        "target": {
          "$ref": "https://warpmetal.com/contracts/workspace-workflow-v1.schema.json#/$defs/resultPin"
        },
        "targetBinding": {
          "$ref": "https://warpmetal.com/contracts/workspace-workflow-v1.schema.json#/$defs/binding"
        },
        "expiresAt": {
          "$ref": "https://warpmetal.com/contracts/workspace-child-product-v1.schema.json#/$defs/time"
        }
      },
      "allOf": [
        {
          "properties": {
            "reference": {
              "properties": {
                "status": {
                  "const": "accepted"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "use": {
                "const": "integration_target_artifact"
              }
            }
          },
          "then": {
            "properties": {
              "artifact": {
                "$ref": "https://warpmetal.com/contracts/workspace-workflow-v1.schema.json#/$defs/artifactRef"
              },
              "byteCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8192
              }
            }
          }
        }
      ]
    },
    "integrationReadRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "binding",
        "assignmentId",
        "use",
        "rootKind",
        "workspace",
        "registeredSourceId",
        "rootAttestation",
        "producer",
        "candidateDescriptorDigest",
        "expiresAt"
