        "rootKind": {
          "const": "workspace"
        },
        "workspace": {
          "$ref": "https://warpmetal.com/contracts/workspace-workflow-producer-v1.schema.json#/$defs/workspace"
        },
        "registeredSourceId": {
          "$ref": "https://warpmetal.com/contracts/workspace-child-product-v1.schema.json#/$defs/id"
        },
        "rootAttestation": {
          "$ref": "https://warpmetal.com/contracts/workspace-child-product-v1.schema.json#/$defs/digest"
        },
        "producer": {
          "$ref": "https://warpmetal.com/contracts/workspace-workflow-producer-v1.schema.json#/$defs/registeredProducer"
