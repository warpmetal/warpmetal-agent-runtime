        },
        "expiresAt": {
          "$ref": "https://warpmetal.com/contracts/workspace-child-product-v1.schema.json#/$defs/time"
        }
      }
    },
    "integrationSourceScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant",
        "root"
      ],
      "properties": {
        "grant": {
          "$ref": "#/$defs/integrationSourceGrant"
        },
        "root": {
          "$ref": "#/$defs/integrationReadRoot"
        }
      }
    },
    "integrationByteSpan": {
      "$comment": "Whole original source encoded losslessly in final immutable UTF-8 firstText. Runtime ROOT Producer owns source custody; Sandbox independently checks delivery and native before image.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference",
        "artifact",
        "rootGrantDigest",
        "encoding",
        "byteCount",
        "offset",
        "length"
      ],
      "properties": {
        "kind": {
          "enum": [
            "packet_source",
            "target_artifact"
          ]
        },
        "reference": {
          "$ref": "https://warpmetal.com/contracts/workspace-workflow-v1.schema.json#/$defs/reference"
        },
        "artifact": {
          "$ref": "https://warpmetal.com/contracts/workspace-workflow-v1.schema.json#/$defs/nullableArtifactRef"
        },
        "rootGrantDigest": {
          "$ref": "https://warpmetal.com/contracts/workspace-workflow-manager-v1.proposal.schema.json#/$defs/digest"
        },
        "encoding": {
          "const": "json_string_fragment_utf8"
        },
        "byteCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "target_artifact"
              }
            }
          },
          "then": {
            "properties": {
              "artifact": {
                "$ref": "https://warpmetal.com/contracts/workspace-workflow-v1.schema.json#/$defs/artifactRef"
              },
              "byteCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8192
              }
            }
          }
        }
      ]
    },
