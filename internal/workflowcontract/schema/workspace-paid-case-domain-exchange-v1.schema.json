{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warpmetal.com/contracts/workspace-paid-case-domain-exchange-v1.schema.json",
  "title": "Private current-node paid case original byte exchange v1",
  "$defs": {
    "originalDigestHex": {
      "type": "string", "pattern": "^[a-f0-9]{64}$"
    },
    "originalByteObject": {
      "type": "object", "additionalProperties": false,
      "required": ["digest", "contentBase64"],
      "properties": {
        "digest": {"$ref": "https://warpmetal.com/contracts/workspace-workflow-v1.schema.json#/$defs/digest"},
        "contentBase64": {
          "type": "string", "maxLength": 349528,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "contentEncoding": "base64"
        }
      }
    },
    "observationRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["formatVersion", "completeInventoryEnvelopeDigest", "demandManifestDigest", "runtimeReadback", "originals"],
      "properties": {
        "formatVersion": {"type": "integer", "const": 1},
        "completeInventoryEnvelopeDigest": {"$ref": "https://warpmetal.com/contracts/workspace-workflow-v1.schema.json#/$defs/digest"},
        "demandManifestDigest": {"$ref": "https://warpmetal.com/contracts/workspace-workflow-v1.schema.json#/$defs/digest"},
        "runtimeReadback": {"$ref": "https://warpmetal.com/contracts/workspace-paid-case-domain-adoption-v1.schema.json#/$defs/paidLedgerReadbackEnvelope"},
        "originals": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/originalByteObject"}}
      }
    }
  }
}
