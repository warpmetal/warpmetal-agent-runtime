{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warpmetal.com/contracts/agent-insights-v1.schema.json",
  "title": "WarpMetal sanitized Insights transport v1",
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "findingId": {
          "type": "string",
          "pattern": "^finding_[a-zA-Z0-9_-]{4,96}$"
        },
        "ruleId": {
          "type": "string",
          "enum": [
            "repeated_identical_failure@1",
            "repeated_identical_call@1",
            "empty_result_loop@1",
            "suspected_stall@1"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "open",
            "resolved"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "firstSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "lastSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "matchedCallIds": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "firstObservedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "lastObservedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "coverage": {
          "type": "string",
          "enum": [
            "complete",
            "partial"
          ]
        },
        "toolCategory": {
          "type": "string",
          "enum": [
            "shell",
            "search",
            "file",
            "network",
            "other",
            "unknown"
          ]
        },
        "phase": {
          "type": "string",
          "enum": [
            "unknown",
            "idle",
            "running_model",
            "running_tool",
            "running_background",
            "waiting_permission",
            "waiting_input",
            "waiting_retry",
            "compacting"
          ]
        },
        "phaseStartedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "lastProgressAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "healthObservedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "stallThresholdMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "predicate": {
                  "type": "string",
                  "enum": [
                    "matching_operation_succeeded",
                    "nonempty_refined_query",
                    "qualified_progress_resumed"
                  ]
                },
                "sequence": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "referenceId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                }
              },
              "required": [
                "predicate",
                "sequence",
                "referenceId"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "findingId",
        "ruleId",
        "state",
        "revision",
        "firstSequence",
        "lastSequence",
        "count",
        "threshold",
        "matchedCallIds",
        "firstObservedAt",
        "lastObservedAt",
        "coverage",
        "toolCategory",
        "phase",
        "phaseStartedAt",
        "lastProgressAt",
        "healthObservedAt",
        "stallThresholdMs",
        "recovery"
      ]
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formatVersion": {
          "const": 1
        },
        "batchId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "sandboxId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "sandboxGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "policyRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "registeredSourceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "serviceRegistrationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "serviceGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "workspaceEpoch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "nativeSessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "journalGeneration": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "throughSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "degraded",
            "unsupported",
            "disabled",
            "unavailable"
          ]
        },
        "gapReason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "monitor_gap",
                "journal_generation_changed",
                "cursor_ahead",
                "source_unavailable",
                "unsupported_agent_version",
                "monitor_disabled",
                "export_unavailable",
                "capacity_exceeded"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "findings": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      },
      "required": [
        "formatVersion",
        "batchId",
        "sandboxId",
        "sandboxGeneration",
        "policyRevision",
        "registeredSourceId",
        "serviceRegistrationId",
        "serviceGeneration",
        "workspaceEpoch",
        "nativeSessionId",
        "journalGeneration",
        "throughSequence",
        "observedAt",
        "status",
        "gapReason",
        "findings"
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "requestId",
        "expectedRevision",
        "enabled"
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "action": {
          "type": "string",
          "enum": [
            "acknowledge",
            "snooze",
            "dismiss"
          ]
        },
        "snoozeSeconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 60,
              "maximum": 86400
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "requestId",
        "expectedRevision",
        "action",
        "snoozeSeconds"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "batch": {
      "$ref": "#/$defs/batch"
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "action": {
      "$ref": "#/$defs/action"
    }
  },
  "required": [
    "batch",
    "settings",
    "action"
  ]
}
