+
+const authorization = `Basic ${btoa("opencode:secret")}`
+
+const setup = Effect.gen(function* () {
+  const handler = yield* ServerFetch.make({
+    app: { version: "test" },
+    database: { path: ":memory:" },
+    events: { persist: true },
+    config: { project: false },
+    models: { fetch: false },
+    fs: { filewatcher: false },
+    password: "secret",
