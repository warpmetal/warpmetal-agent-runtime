+      yield* SessionInbox.promote(db, bus, sessionID, "input")
+      expect((yield* visible()).some((row) => row.id === "msg_guard_interrupted")).toBe(false)
+
+      // A new active execution is the current basis for the context-change isolation case.
+      yield* bus.publish(SessionEvent.Execution.Started, { sessionID })
+      const nextStartedSeq = (yield* latestSeq(Bus.versionedType(SessionEvent.Execution.Started.type, 1)))?.seq ?? 0
+
+      // Meaningful config change invalidates the context snapshot of the current execution.
+      yield* guarded(
+        "msg_guard_context",
+        "Context guarded steer",
+        guardFor({
+          guardID: "guard_test_context",
+          inputSeq: yield* latestInputSeq(),
