+      expect((yield* refusals()).map((row) => row.data)).toContainEqual(
+        expect.objectContaining({ inboxID: "msg_guard_expired_at_admission", code: "guard_expired" }),
+      )
+
+      // A lease admitted fresh that expires before promotion is refused at delivery, never promoted.
+      yield* guarded(
+        "msg_guard_expired_after_admission",
+        "Expired after admission",
+        guardFor({
+          guardID: "guard_test_expired_after",
+          inputSeq: yield* latestInputSeq(),
+          executionStartedSeq: startedSeq,
+          expiresAt: Date.now() + 20,
+        }),
+      )
