+it.live("refuses a guarded prompt with typed 409 and a durable session-log receipt", () =>
+  Effect.gen(function* () {
+    const fixture = yield* setup
+    const session = yield* Effect.promise(() => fixture.api.session.create({ title: "Guard refusal" }))
+    const guard = {
+      formatVersion: 1 as const,
+      guardID: "guard_http_0001",
+      sessionID: session.id,
+      inputSeq: null,
+      executionStartedSeq: 0,
+      contextSeq: null,
+      expiresAt: Date.now() + 60_000,
+      bindingDigest: "sha256:" + "e".repeat(64),
+    }
+    const refused = (id: string) =>
+      fixture.api.session
+        .prompt({ sessionID: session.id, id, text: "Stale guarded steer", guard, resume: false })
+        .then(
+          () => undefined,
+          (error: unknown) => error,
+        )
+
+    const refusal = yield* Effect.promise(() => refused("msg_guard_http"))
+    expect(refusal).toMatchObject({
+      _tag: "SessionInboxRefusedError",
+      sessionID: session.id,
+      inboxID: "msg_guard_http",
+      guardID: "guard_http_0001",
+      bindingDigest: "sha256:" + "e".repeat(64),
+      code: "guard_execution_changed",
+    })
+
+    const inbox = yield* Effect.promise(() => fixture.api.session.inbox.list({ sessionID: session.id }))
+    expect(inbox.some((item) => item.id === "msg_guard_http")).toBe(false)
+
+    const events: Array<{ type?: string }> = []
+    yield* Effect.promise(async () => {
+      const abort = new AbortController()
+      try {
+        for await (const event of fixture.api.session.log({ sessionID: session.id, after: 0 }, { signal: abort.signal })) {
+          events.push(event as { type?: string })
+          if (events.some((item) => item.type === "session.inbox.refused")) break
+        }
+      } finally {
+        abort.abort()
+      }
+    })
+    expect(events).toContainEqual(expect.objectContaining({ type: "session.inbox.refused" }))
+
+    // The durable receipt reconciles a retry: the same id cannot be silently re-admitted.
+    const again = yield* Effect.promise(() => refused("msg_guard_http"))
+    expect(again).toMatchObject({ _tag: "SessionInboxRefusedError", code: "guard_execution_changed" })
+  }),
+)
