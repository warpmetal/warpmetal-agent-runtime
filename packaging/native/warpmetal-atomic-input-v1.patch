+it.live("serves the guard snapshot over authenticated HTTP and rejects anonymous access", () =>
+  Effect.gen(function* () {
+    const fixture = yield* setup
+    const session = yield* Effect.promise(() => fixture.api.session.create({ title: "Guard snapshot" }))
+
+    const anonymous = yield* Effect.promise(() =>
+      fixture.handler(new Request(`http://opencode.local/api/session/${session.id}/inbox/guard`, { method: "GET" })),
+    )
+    expect(anonymous.status).toBe(401)
+
+    const snapshot = yield* Effect.promise(() => fixture.api.session.inbox.guard({ sessionID: session.id }))
+    expect(snapshot).toMatchObject({
+      formatVersion: 1,
+      nativeGuardVersion: "warpmetal.atomic-input.v1",
+      sessionID: session.id,
+      inputSeq: null,
+      executionStartedSeq: null,
+      executionTerminalSeq: null,
+      contextSeq: null,
+      active: false,
+    })
+    expect(snapshot.logCursor === null || typeof snapshot.logCursor === "number").toBe(true)
+  }),
+)
