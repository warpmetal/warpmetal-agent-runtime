+      // Cancel wins promotion for a pending guarded steer and stays a distinct disposition.
+      const cancelGuard = guardFor({
+        guardID: "guard_test_cancel",
+        inputSeq: yield* latestInputSeq(),
+        executionStartedSeq: nextStartedSeq,
+      })
+      yield* guarded("msg_guard_cancel", "Cancelled guarded steer", cancelGuard)
+      yield* session.cancelInbox({ sessionID, inboxID: SessionMessage.ID.make("msg_guard_cancel") })
+      yield* SessionInbox.promote(db, bus, sessionID, "input")
+      expect((yield* visible()).some((row) => row.id === "msg_guard_cancel")).toBe(false)
+      expect((yield* refusals()).every((row) => (row.data as { inboxID?: string }).inboxID !== "msg_guard_cancel")).toBe(true)
+
+      // Durable refusal receipts survive restart and prevent silent re-admission.
+      const before = (yield* refusals()).length
+      const readmit = yield* guarded("msg_guard_stale", "Stale guarded steer", staleGuard).pipe(Effect.exit)
+      expect(Exit.isFailure(readmit)).toBe(true)
