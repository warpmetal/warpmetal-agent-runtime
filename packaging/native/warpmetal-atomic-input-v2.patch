@@ -0,0 +1,300 @@
+import { expect } from "bun:test"
+import { App } from "@opencode/core/app"
+import { Bus } from "@opencode/core/bus"
+import { Database } from "@opencode/core/database/database"
+import { llmClient } from "@opencode/core/effect/app-node-platform"
+import { Watcher } from "@opencode/core/filesystem/watcher"
+import { Instance } from "@opencode/core/instance"
+import { LocationServiceMap } from "@opencode/core/location-service-map"
+import { ModelsDev } from "@opencode/core/models-dev"
+import { Plugin } from "@opencode/core/plugin"
+import { Session } from "@opencode/core/session"
+import { SessionMessage } from "@opencode/core/session/message"
+import { SessionRunnerModel } from "@opencode/core/session/runner/model"
+import { define } from "@opencode/plugin/effect/plugin"
+import { Agent } from "@opencode/schema/agent"
+import { Location } from "@opencode/schema/location"
+import { AbsolutePath } from "@opencode/schema/schema"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { makeGlobalNode } from "@opencode/util/effect/app-node"
+import { Global } from "@opencode/util/global"
+import { Context, Deferred, Duration, Effect, Fiber, Layer, LayerMap, Schema } from "effect"
+import { HttpEffect, HttpRouter, HttpServer } from "effect/unstable/http"
+import { LanguageModel, LLMClient } from "../../ai/src"
+import { OpenAIChat } from "../../ai/src/protocols/openai-chat"
+import { TestLLM } from "../../ai/src/testing"
+import { tempGlobalLayer } from "../../core/test/fixture/global"
+import { tmpdirScoped } from "../../core/test/fixture/tmpdir"
+import { it } from "../../core/test/lib/effect"
+import { createEmbeddedRoutes } from "../src/routes"
+
+it.live("default persist=false: guard must see a real in-flight blocked tool (RED today)", () =>
+  Effect.gen(function* () {
+    const directory = yield* tmpdirScoped()
+    const location = Location.Ref.make({ directory: AbsolutePath.make(directory.path) })
+    const sessionID = Session.ID.make("ses_durability_red")
+    const toolName = "durability_blocked_tool"
+    const started = yield* Deferred.make<void>()
+    const release = yield* Deferred.make<void>()
+    const llm = yield* TestLLM.Test.pipe(Effect.provide(TestLLM.testLayer()))
+    const model = SessionRunnerModel.resolved(
+      LanguageModel.make({ id: "durability-model", provider: "test", route: OpenAIChat.route }),
+      {
+        capabilities: { tools: true, input: ["text"], output: ["text"] },
+        cost: [],
+        limit: { context: 200_000, output: 8_192 },
+      },
+    )
+    const replacements: LayerNode.Replacements = [
+      Global.node.replace(tempGlobalLayer),
+      Database.node.replace(Database.node),
+      Bus.node.replace(Bus.node),
+      App.node.replace(App.node),
+      ModelsDev.node.replace(ModelsDev.configured({ fetch: false })),
+      Watcher.node.replace(Watcher.configured({ enabled: false })),
+      llmClient.replace(Layer.succeed(LLMClient.Service, llm)),
+      SessionRunnerModel.node.replace(
+        Layer.succeed(SessionRunnerModel.Service, { resolve: () => Effect.succeed(model) }),
+      ),
+      Instance.node.replace(
+        makeGlobalNode({
+          service: Instance.Service,
+          deps: [LocationServiceMap.node],
+          layer: Layer.effect(
+            Instance.Service,
+            Effect.gen(function* () {
+              const locations = yield* LocationServiceMap.Service
+              const instances = yield* LayerMap.make(
+                (id: Session.ID) => {
+                  if (id !== sessionID) throw new Error(`No instance configuration for ${id}`)
+                  return Instance.layer(location, {
+                    discovery: false,
+                    replacements: bindings,
+                    plugins: [
+                      define({
+                        id: "durability-instance",
+                        effect: Effect.fnUntraced(function* (ctx) {
+                          yield* ctx.agent.transform((editor) =>
+                            editor.update("build", (agent) => {
+                              agent.permissions = [{ action: "*", resource: "*", effect: "allow" }]
+                            }),
+                          )
+                          yield* ctx.tool.transform((editor) =>
+                            editor.add({
+                              name: toolName,
+                              description: "Blocked tool for the guard durability RED",
+                              input: Schema.Struct({}),
+                              output: Schema.String,
+                              options: { codemode: false },
+                              execute: () =>
+                                Effect.gen(function* () {
+                                  yield* Deferred.succeed(started, undefined)
+                                  yield* Deferred.await(release)
+                                  return { output: "released", content: "released" }
+                                }),
+                            }),
+                          )
+                        }),
+                      }),
+                    ],
+                  })
+                },
+                { idleTimeToLive: Duration.infinity },
+              )
+              const selector = Instance.Service.of({
+                provide: (session) => Effect.provide(instances.get(session.id)),
+              })
+              const bindings: LayerNode.Replacements = [
+                ...replacements,
+                Instance.node.replace(Layer.succeed(Instance.Service, selector)),
+                LocationServiceMap.node.replace(Layer.succeed(LocationServiceMap.Service, locations)),
+              ]
+              return selector
+            }),
+          ),
+        }),
+      ),
+    ]
+    const context = yield* Layer.build(
+      createEmbeddedRoutes({}, replacements).pipe(Layer.provide(HttpServer.layerServices)),
+    )
+    const sessions = Context.get(context, Session.Service)
+    const instances = Context.get(context, Instance.Service)
+    yield* sessions.create({
+      id: sessionID,
+      title: "guard durability",
+      agent: Agent.ID.make("build"),
+      model: model.ref,
+      location,
+    })
+    const session = yield* sessions.get(sessionID)
+    yield* Plugin.Service.use((plugins) => plugins.awaitActivation).pipe(instances.provide(session))
+    yield* sessions.prompt({ sessionID, text: "run blocked tool", resume: false })
+    yield* llm.push(TestLLM.tool("call_blocked", toolName, {}), TestLLM.text("done", "durability_done"))
+    const fiber = yield* Effect.forkChild(sessions.resume(sessionID), { startImmediately: true })
+    yield* Deferred.await(started)
+    // The controlled tool is now actually in flight.
+    const snapshot = yield* sessions.guardSnapshot(sessionID)
+    // RED today: default persist=false leaves the EventTable empty, so the guard reports
+    // all-null/false while a real execution with a real in-flight tool is running.
+    expect(snapshot.executionStartedSeq).not.toBeNull()
+    expect(snapshot.active).toBe(true)
+    yield* Deferred.succeed(release, undefined)
+    yield* Fiber.join(fiber)
+    const terminal = yield* sessions.guardSnapshot(sessionID)
+    expect(terminal.executionTerminalSeq).not.toBeNull()
+    expect(terminal.active).toBe(false)
+  }),
+)
+
+it.live("default persist=false: guarded guidance admitted, consumed, receipt durable across reopen", () =>
+  Effect.gen(function* () {
+    const directory = yield* tmpdirScoped()
+    const dbPath = directory.path + "/guard-receipt.db"
+    const location = Location.Ref.make({ directory: AbsolutePath.make(directory.path) })
+    const sessionID = Session.ID.make("ses_durability_receipt")
+    const inboxID = SessionMessage.ID.make("msg_durability_guide")
+    const guardID = "guard_durability_guide"
+    const steerText = "Guided steer text"
+    const started = yield* Deferred.make<void>()
+    const release = yield* Deferred.make<void>()
+    const llm = yield* TestLLM.Test.pipe(Effect.provide(TestLLM.testLayer()))
+    const model = SessionRunnerModel.resolved(
+      LanguageModel.make({ id: "durability-receipt-model", provider: "test", route: OpenAIChat.route }),
+      { capabilities: { tools: true, input: ["text"], output: ["text"] }, cost: [], limit: { context: 200_000, output: 8_192 } },
+    )
+    const base: LayerNode.Replacements = [
+      Global.node.replace(tempGlobalLayer),
+      Database.node.replace(Database.configured({ path: dbPath })),
+      Bus.node.replace(Bus.node),
+      App.node.replace(App.node),
+      ModelsDev.node.replace(ModelsDev.configured({ fetch: false })),
+      Watcher.node.replace(Watcher.configured({ enabled: false })),
+      llmClient.replace(Layer.succeed(LLMClient.Service, llm)),
+      SessionRunnerModel.node.replace(Layer.succeed(SessionRunnerModel.Service, { resolve: () => Effect.succeed(model) })),
+    ]
+    const build = (replacements: LayerNode.Replacements) =>
+      Layer.build(createEmbeddedRoutes({}, replacements).pipe(Layer.provide(HttpServer.layerServices))).pipe(
+        Effect.map((context) => {
+          const sessions = Context.get(context, Session.Service)
+          const instances = Context.get(context, Instance.Service)
+          const handler = Context.get(context, HttpRouter.HttpRouter)
+            .asHttpEffect()
+            .pipe(HttpEffect.toWebHandlerWith(context))
+          return { sessions, instances, handler }
+        }),
+      )
+    const full = yield* build([
+      ...base,
+      Instance.node.replace(
+        makeGlobalNode({
+          service: Instance.Service,
+          deps: [LocationServiceMap.node],
+          layer: Layer.effect(
+            Instance.Service,
+            Effect.gen(function* () {
+              const locations = yield* LocationServiceMap.Service
+              const instances = yield* LayerMap.make(
+                (id: Session.ID) => {
+                  if (id !== sessionID) throw new Error(`No instance configuration for ${id}`)
+                  return Instance.layer(location, {
+                    discovery: false,
+                    replacements: bindings,
+                    plugins: [
+                      define({
+                        id: "durability-receipt-instance",
+                        effect: Effect.fnUntraced(function* (ctx) {
+                          yield* ctx.agent.transform((editor) =>
+                            editor.update("build", (agent) => {
+                              agent.permissions = [{ action: "*", resource: "*", effect: "allow" }]
+                            }),
+                          )
+                          yield* ctx.tool.transform((editor) =>
+                            editor.add({
+                              name: "durability_receipt_tool",
+                              description: "Blocked tool for the receipt journey",
+                              input: Schema.Struct({}),
+                              output: Schema.String,
+                              options: { codemode: false },
+                              execute: () =>
+                                Effect.gen(function* () {
+                                  yield* Deferred.succeed(started, undefined)
+                                  yield* Deferred.await(release)
+                                  return { output: "released", content: "released" }
+                                }),
+                            }),
+                          )
+                        }),
+                      }),
+                    ],
+                  })
+                },
+                { idleTimeToLive: Duration.infinity },
+              )
+              const selector = Instance.Service.of({ provide: (session) => Effect.provide(instances.get(session.id)) })
+              const bindings: LayerNode.Replacements = [
+                ...base,
+                Instance.node.replace(Layer.succeed(Instance.Service, selector)),
+                LocationServiceMap.node.replace(Layer.succeed(LocationServiceMap.Service, locations)),
+              ]
+              return selector
+            }),
+          ),
+        }),
+      ),
+    ])
+    const { sessions, handler } = full
+    yield* sessions.create({ id: sessionID, title: "receipt", agent: Agent.ID.make("build"), model: model.ref, location })
+    const session = yield* sessions.get(sessionID)
+    yield* Plugin.Service.use((plugins) => plugins.awaitActivation).pipe(full.instances.provide(session))
+    yield* sessions.prompt({ sessionID, text: "run blocked", resume: false })
+    yield* llm.push(TestLLM.tool("call_receipt", "durability_receipt_tool", {}), TestLLM.text("done", "durability_receipt_done"))
+    const fiber = yield* Effect.forkChild(sessions.resume(sessionID), { startImmediately: true })
+    yield* Deferred.await(started)
+    const snapshot = yield* sessions.guardSnapshot(sessionID)
+    if (snapshot.executionStartedSeq === null) return yield* Effect.die(new Error("execution not started"))
+    const guard = {
+      formatVersion: 1 as const,
+      guardID,
+      sessionID,
+      inputSeq: snapshot.inputSeq,
+      executionStartedSeq: snapshot.executionStartedSeq,
+      contextSeq: snapshot.contextSeq,
+      expiresAt: Date.now() + 60_000,
+      bindingDigest: "sha256:" + "d".repeat(64),
+    }
+    yield* sessions.prompt({ sessionID, id: inboxID, text: steerText, guard })
+    const admitted = yield* sessions.guardReceipt({ sessionID, inboxID, guardID })
+    expect(admitted).toMatchObject({ state: "admitted", guardID, bindingDigest: guard.bindingDigest })
+    expect(typeof admitted?.admittedAt).toBe("number")
+    expect(admitted?.availableAt ?? null).toBeNull()
+    yield* Deferred.succeed(release, undefined)
+    yield* Fiber.join(fiber)
+    const delivered = yield* sessions.guardReceipt({ sessionID, inboxID, guardID })
+    expect(delivered).toMatchObject({ state: "delivered", guardID })
+    expect(typeof delivered?.admittedAt).toBe("number")
+    expect(typeof delivered?.availableAt).toBe("number")
+    expect(typeof delivered?.settledAt).toBe("number")
+    const messages = yield* sessions.messages({ sessionID })
+    expect(JSON.stringify(messages)).toContain(steerText)
+    const route = `/api/session/${sessionID}/inbox/${inboxID}/guard-receipt?guardID=${guardID}`
+    const response = yield* Effect.promise(() => handler(new Request(`http://opencode.local${route}`)))
+    expect(response.status).toBe(200)
+    const body = (yield* Effect.promise(() => response.json())) as { data: Record<string, unknown> }
+    expect(body.data).toMatchObject({ state: "delivered", sessionID, inboxID, guardID })
+    expect(body.data.admittedAt).not.toBeNull()
+    expect(body.data.availableAt).not.toBeNull()
+    expect(body.data.settledAt).not.toBeNull()
+    const reopened = yield* build(base)
+    const again = yield* Effect.promise(() => reopened.handler(new Request(`http://opencode.local${route}`)))
+    expect(again.status).toBe(200)
+    const againBody = (yield* Effect.promise(() => again.json())) as { data: Record<string, unknown> }
+    expect(againBody.data).toMatchObject({
+      state: "delivered",
+      sessionID,
+      inboxID,
+      guardID,
+      bindingDigest: guard.bindingDigest,
+    })
