# WarpMetal's signed sandbox image owns this exact helper as root:root, mode
# 0555.  This profile deliberately does not attach to a distribution bwrap or
# to a workspace-provided executable.
#
# The setup/child split follows AppArmor's restricted-bwrap profile. Bubblewrap
# needs capabilities while it constructs the requested namespaces and mounts;
# every executable that it starts is stacked with the capability-denying child
# profile.  The stack is required because Bubblewrap enables no-new-privileges.

abi <abi/4.0>,

include <tunables/global>

profile warpmetal-agent-runtime-bwrap /opt/warpmetal-agent-tools/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/codex-resources/bwrap flags=(attach_disconnected,mediate_deleted) {
  allow capability,

  # AppArmor profile stacking currently requires execute mappings to remain
  # available to the child profile.  Do not replace this with an unconditional
  # allow rule: the explicit permissions keep the pix transition enforceable.
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,

  # Stack the target executable with both this setup profile and the child
  # profile.  The ix fallback is intentional and mirrors upstream's handling
  # of no-new-privileges.
  allow pix /** -> &warpmetal-agent-runtime-bwrap//&warpmetal-agent-runtime-unpriv-bwrap,
}

profile warpmetal-agent-runtime-unpriv-bwrap flags=(attach_disconnected,mediate_deleted) {
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,

  # Preserve the capability-denying stack across every descendant exec,
  # including an attempted nested Bubblewrap invocation.
  allow pix /** -> &warpmetal-agent-runtime-unpriv-bwrap,

  audit deny capability,
}
